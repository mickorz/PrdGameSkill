{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prdgameskill.local/schemas/manifest.schema.json",
  "title": "Game Spec Manifest",
  "type": "object",
  "required": ["format", "ir_version", "game_name", "source_files"],
  "properties": {
    "format": { "const": "GAME-SPEC/1" },
    "ir_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "game_name": { "type": "string", "minLength": 1 },
    "game_version": { "type": "string" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string" },
          "received_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "entry_points": { "type": "array", "items": { "type": "string", "pattern": "^GAME-UI-[0-9]{3,4}$" } },
    "stats": {
      "type": "object",
      "properties": {
        "requirements": { "type": "integer", "minimum": 0 },
        "ui_pages": { "type": "integer", "minimum": 0 },
        "test_cases": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "additionalProperties": false
}
