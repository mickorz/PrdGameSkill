{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prdgameskill.local/schemas/test.schema.json",
  "title": "Test Spec (case / scenario)",
  "$defs": {
    "case": {
      "title": "Test Case",
      "type": "object",
      "required": ["id", "name", "type", "related_requirements", "steps", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^GAME-TC-[0-9]{3,4}$" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["normal", "illegal", "boundary", "abnormal"] },
        "related_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^GAME-" } },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "expected": { "type": "string", "minLength": 1 },
        "rule_refs": { "type": "array", "items": { "type": "string", "pattern": "^GAME-RULE-" } }
      },
      "additionalProperties": false
    },
    "scenario": {
      "title": "Test Scenario",
      "type": "object",
      "required": ["id", "name", "initial_state", "actions"],
      "properties": {
        "id": { "type": "string", "pattern": "^SCEN-[0-9]{3,4}$" },
        "name": { "type": "string", "minLength": 1 },
        "initial_state": { "type": "object" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["player", "action"],
            "properties": {
              "player": { "type": "string" },
              "action": { "type": "string" },
              "args": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "expected": { "type": "string" },
        "case_refs": { "type": "array", "items": { "type": "string", "pattern": "^GAME-TC-" } }
      },
      "additionalProperties": false
    }
  }
}
