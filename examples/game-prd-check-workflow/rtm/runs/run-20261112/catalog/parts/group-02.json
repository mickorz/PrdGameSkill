[
  {
    "ruleId": "R02-001",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "总览-什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "任一玩家打出一张牌时进入出牌流程",
    "mandatory": false
  },
  {
    "ruleId": "R02-002",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据记录-1",
    "fromLine": 7,
    "toLine": 7,
    "text": "别人出牌时，自己的记牌器扣掉这张牌",
    "mandatory": true
  },
  {
    "ruleId": "R02-003",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据记录-2",
    "fromLine": 8,
    "toLine": 8,
    "text": "记录该玩家托管出牌的次数",
    "mandatory": true
  },
  {
    "ruleId": "R02-004",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据记录-3",
    "fromLine": 9,
    "toLine": 9,
    "text": "记录该玩家打出的牌",
    "mandatory": true
  },
  {
    "ruleId": "R02-005",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据记录-4",
    "fromLine": 10,
    "toLine": 10,
    "text": "自己出牌时，从打听表取出打这张能听什么的信息并保存，然后清空打听表",
    "mandatory": true
  },
  {
    "ruleId": "R02-006",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据记录-5",
    "fromLine": 11,
    "toLine": 11,
    "text": "记录最后一张出牌，重连时用于恢复箭头位置",
    "mandatory": true
  },
  {
    "ruleId": "R02-007",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-手牌",
    "fromLine": 17,
    "toLine": 17,
    "text": "自己：手牌移除这张并可能重新排序，随后收起操作区；别人：对应手牌做一次打牌动作，手牌重排",
    "mandatory": true
  },
  {
    "ruleId": "R02-008",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-河牌区",
    "fromLine": 18,
    "toLine": 18,
    "text": "打出的牌落到该玩家的河牌区；落定后播放出牌落地特效，受动画开关控制，播完自动隐藏",
    "mandatory": true
  },
  {
    "ruleId": "R02-009",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-出牌放大牌面",
    "fromLine": 19,
    "toLine": 19,
    "text": "先隐藏所有放大牌；若开启放大出牌且不是自己出牌，则在对应玩家位置放大显示这张牌并做财神染色",
    "mandatory": true
  },
  {
    "ruleId": "R02-010",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-听牌箭头",
    "fromLine": 20,
    "toLine": 20,
    "text": "自己出牌后刷新打哪张听什么的箭头；如果还留有打听数据则保留箭头，否则清空",
    "mandatory": true
  },
  {
    "ruleId": "R02-011",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-听牌按钮",
    "fromLine": 21,
    "toLine": 21,
    "text": "自己出牌后关闭听牌弹窗：没有听牌或已胡则隐藏听牌按钮；有听牌则显示并标记可胡状态",
    "mandatory": true
  },
  {
    "ruleId": "R02-012",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-听牌闪光",
    "fromLine": 22,
    "toLine": 22,
    "text": "自己此前没播过听牌闪光时，播放一次手牌闪光",
    "mandatory": true
  },
  {
    "ruleId": "R02-013",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-听牌界面（他人出牌）",
    "fromLine": 23,
    "toLine": 23,
    "text": "他人出牌时刷新听牌列表里各张牌的剩余张数",
    "mandatory": true
  },
  {
    "ruleId": "R02-014",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-操作区",
    "fromLine": 24,
    "toLine": 24,
    "text": "收起吃碰杠胡按钮，隐藏多吃/多杠选择，清掉文字提示与庄家提示；已胡时恢复手牌",
    "mandatory": true
  },
  {
    "ruleId": "R02-015",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-手牌置灰",
    "fromLine": 25,
    "toLine": 25,
    "text": "清除本回合的出牌限制置灰，手牌恢复可点",
    "mandatory": true
  },
  {
    "ruleId": "R02-016",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化-音效",
    "fromLine": 26,
    "toLine": 26,
    "text": "播报这张牌的方言语音（真财神或白板替牌会换播报内容），并播放出牌音效",
    "mandatory": true
  },
  {
    "ruleId": "R02-017",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "三、连带影响-1",
    "fromLine": 30,
    "toLine": 30,
    "text": "自己出牌且听牌加手里只有一张财神连续未胡时累积次数，用于好运来图标切换或道具引导",
    "mandatory": true
  },
  {
    "ruleId": "R02-018",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "三、连带影响-2",
    "fromLine": 31,
    "toLine": 31,
    "text": "河牌里出现财神牌时会自动染色",
    "mandatory": true
  },
  {
    "ruleId": "R02-019",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "三、连带影响-3",
    "fromLine": 32,
    "toLine": 32,
    "text": "复盘模式下会隐藏复盘操作按钮",
    "mandatory": true
  },
  {
    "ruleId": "R02-020",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "四、重连/回放",
    "fromLine": 36,
    "toLine": 36,
    "text": "只记录记牌器、托管次数、手牌、听牌信息与最后出牌：不播动画、不放大、不刷新听牌界面、不播语音，也不触发好运来累积",
    "mandatory": true
  },
  {
    "ruleId": "R02-021",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "总览-什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "某个玩家吃了上家打出的牌时进入吃流程",
    "mandatory": false
  },
  {
    "ruleId": "R02-022",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "一、数据记录-1",
    "fromLine": 7,
