    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "总览-什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "某个玩家明杠、暗杠或补杠时进入杠流程",
    "mandatory": false
  },
  {
    "ruleId": "R02-052",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据记录-1",
    "fromLine": 7,
    "toLine": 7,
    "text": "桌面进入杠状态",
    "mandatory": true
  },
  {
    "ruleId": "R02-053",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据记录-2",
    "fromLine": 8,
    "toLine": 8,
    "text": "在副露区记录这组牌",
    "mandatory": true
  },
  {
    "ruleId": "R02-054",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据记录-3",
    "fromLine": 9,
    "toLine": 9,
    "text": "明杠时清掉最后一张出牌",
    "mandatory": true
  },
  {
    "ruleId": "R02-055",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据记录-4",
    "fromLine": 10,
    "toLine": 10,
    "text": "不是自己杠时，自己的记牌器扣掉这组牌",
    "mandatory": true
  },
  {
    "ruleId": "R02-056",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化-操作区",
    "fromLine": 16,
    "toLine": 16,
    "text": "收起操作区，隐藏多选池与多杠选择，清提示",
    "mandatory": true
  },
  {
    "ruleId": "R02-057",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化-出牌放大牌面",
    "fromLine": 17,
    "toLine": 17,
    "text": "隐藏出牌放大牌面",
    "mandatory": true
  },
  {
    "ruleId": "R02-058",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化-吃碰杠飘动画位",
    "fromLine": 18,
    "toLine": 18,
    "text": "该座位播放杠动画；语音按类型区分：明杠、暗杠、补杠各有一条",
    "mandatory": true
  },
  {
    "ruleId": "R02-059",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化-副露区（明杠/暗杠）",
    "fromLine": 19,
    "toLine": 19,
    "text": "明杠/暗杠新增一组副露；刷新副露来源箭头；手牌重排；重刷财神颜色",
    "mandatory": true
  },
  {
    "ruleId": "R02-060",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化-副露区（补杠）",
    "fromLine": 20,
    "toLine": 20,
    "text": "补杠先把手里那张牌去掉，再把这张牌追加到原来的刻子上（不新增一格副露）；重刷财神颜色",
    "mandatory": true
  },
  {
    "ruleId": "R02-061",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化-玩家头像（自己托管时）",
    "fromLine": 21,
    "toLine": 21,
    "text": "自己托管时收起操作区、清提示、恢复手牌可点状态",
    "mandatory": true
  },
  {
    "ruleId": "R02-062",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化-听牌界面（别人杠）",
    "fromLine": 22,
    "toLine": 22,
    "text": "别人杠时刷新听牌列表剩余张数",
    "mandatory": true
  },
  {
    "ruleId": "R02-063",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "三、连带影响-1",
    "fromLine": 26,
    "toLine": 26,
    "text": "杠牌权、杠上花、杠后听牌提示分别由权限和听牌信息继续处理，不在本消息里",
    "mandatory": true
  },
  {
    "ruleId": "R02-064",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "三、连带影响-2",
    "fromLine": 27,
    "toLine": 27,
    "text": "暗杠时别人看不到具体牌，但记牌器仍按协议扣减",
    "mandatory": true
  },
  {
    "ruleId": "R02-065",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "三、连带影响-3",
    "fromLine": 28,
    "toLine": 28,
    "text": "一次能杠好几种的多杠选择由权限消息里的多杠列表负责，本消息不涉及",
    "mandatory": true
  },
  {
    "ruleId": "R02-066",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "四、重连/回放",
    "fromLine": 32,
    "toLine": 32,
    "text": "只记录数据；补杠与普通杠在副露区的差异，重连时由恢复手牌统一还原",
    "mandatory": true
  }
