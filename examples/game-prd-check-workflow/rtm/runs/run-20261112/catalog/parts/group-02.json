    "mandatory": true
  },
  {
    "ruleId": "R02-024",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "一、数据记录-3",
    "fromLine": 9,
