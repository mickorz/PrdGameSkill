  },
  {
    "ruleId": "R07-007",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "二、界面变化（流程）",
    "fromLine": 17,
    "toLine": 17,
    "text": "动画全部结束后向服务端确认一次，推进流程",
    "mandatory": true
  },
  {
    "ruleId": "R07-008",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "三、异常处理",
    "fromLine": 21,
    "toLine": 21,
    "text": "数据不合法（人数不是4人、座位越界、骰子点数不在1~6、赔付金额异常等）时直接跳过动画并回包，避免卡住",
    "mandatory": true
  },
  {
    "ruleId": "R07-009",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "四、连带影响",
    "fromLine": 25,
    "toLine": 25,
    "text": "骰子期间倒计时区域被临时屏蔽，骰子结束或本次流程失效后自动恢复",
    "mandatory": true
  },
  {
    "ruleId": "R07-010",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "四、连带影响",
    "fromLine": 26,
    "toLine": 26,
    "text": "回放时用保存的数据静态重放，且不会向服务端确认",
    "mandatory": true
  },
  {
    "ruleId": "R07-011",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "五、重连 / 回放",
    "fromLine": 30,
    "toLine": 30,
    "text": "只补数据时：保存数据，不播动画、不播飘分",
    "mandatory": true
  },
  {
    "ruleId": "R07-012",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/28-升庄广播.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
