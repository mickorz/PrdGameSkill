[
  {
    "ruleId": "R07-001",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "跟庄成功、且房间规则选择“摇骰子赔付”时出现跟庄重扔骰子流程",
    "mandatory": true
  },
  {
    "ruleId": "R07-002",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "一、数据上记录了什么",
    "fromLine": 7,
    "toLine": 7,
    "text": "保存这次跟庄骰子的完整数据，供回放拖动或跳转到该步时静态还原",
    "mandatory": true
  },
  {
    "ruleId": "R07-003",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
    "section": "二、界面变化（牌桌中央倒计时区）",
    "fromLine": 13,
    "toLine": 13,
    "text": "牌桌中央倒计时区先临时屏蔽倒计时数字与方位灯闪烁，业务计时继续",
    "mandatory": true
  },
  {
    "ruleId": "R07-004",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/27-跟庄重扔骰子.md",
