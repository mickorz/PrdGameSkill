  },
  {
    "ruleId": "R11-014",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "4.1 配置项-财神替豪七",
    "fromLine": 217,
    "toLine": 217,
    "text": "财神替豪七开/关；好友房默认关，金币场固定开；财神可补足豪华七对四张相同牌，数量按财神预算",
