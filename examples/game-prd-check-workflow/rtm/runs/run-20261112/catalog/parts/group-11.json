  },
  {
    "ruleId": "R11-011",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "4.1 配置项-有财必拷响",
    "fromLine": 214,
    "toLine": 214,
    "text": "有财必拷响开/关；好友房默认关，金币场默认关可配；手牌含财神时普通自摸无效",
