  {
    "ruleId": "R11-026",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "4.1 配置项-单局输分封顶",
    "fromLine": 229,
    "toLine": 229,
    "text": "单局输分封顶取 0/20/40/64/80/128/256；好友房默认 0；金币场不解析；仅好友房",
