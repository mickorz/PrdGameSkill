  },
  {
    "ruleId": "R11-021",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "4.1 配置项-碰禁手",
    "fromLine": 224,
    "toLine": 224,
    "text": "碰禁手开/关；好友房默认开，金币场默认开可配；碰后禁打被碰牌",
