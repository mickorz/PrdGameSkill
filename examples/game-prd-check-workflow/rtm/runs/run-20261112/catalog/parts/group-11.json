  },
  {
    "ruleId": "R11-027",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "4.1 配置项-打片起始片数",
    "fromLine": 230,
    "toLine": 230,
    "text": "打片起始片数：>0 表示打片房；好友房默认 0；金币场不解析；仅好友房",
