[
  { "ruleId": "R16-001", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.1 结算参数", "fromLine": 855, "toLine": 855, "text": "B 表示底分。", "mandatory": true },
  { "ruleId": "R16-002", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.1 结算参数", "fromLine": 856, "toLine": 856, "text": "F 表示番型倍数（含三/四财、十风超出、倍数封顶）。", "mandatory": true },
  { "ruleId": "R16-003", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.1 结算参数", "fromLine": 857, "toLine": 857, "text": "M 表示牢庄倍数 = 2^牢庄档位。", "mandatory": true },
  { "ruleId": "R16-004", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.1 结算参数", "fromLine": 858, "toLine": 858, "text": "D胜 表示胡牌方加倍倍数（1 或 2）。", "mandatory": true },
  { "ruleId": "R16-005", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.1 结算参数", "fromLine": 859, "toLine": 859, "text": "D付 表示付款方加倍倍数（1 或 2）。", "mandatory": true },
  { "ruleId": "R16-006", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付", "fromLine": 864, "toLine": 864, "text": "点炮：放铳者应付 B × F × M × D胜。", "mandatory": true },
  { "ruleId": "R16-007", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付", "fromLine": 865, "toLine": 865, "text": "抢杠胡·庄家赢：杠牌者应付 B × F × M × (人数−1) × D胜。", "mandatory": true },
  { "ruleId": "R16-008", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付", "fromLine": 866, "toLine": 866, "text": "抢杠胡·闲家赢：杠牌者应付 B × F × (M + 人数−2) × D胜。", "mandatory": true },
  { "ruleId": "R16-009", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付", "fromLine": 867, "toLine": 867, "text": "自摸·庄家赢：每个闲家应付 B × F × M × D胜。", "mandatory": true },
  { "ruleId": "R16-010", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付", "fromLine": 868, "toLine": 868, "text": "自摸·闲家赢：庄家应付 B × F × M × D胜。", "mandatory": true },
  { "ruleId": "R16-011", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付", "fromLine": 869, "toLine": 869, "text": "自摸·闲家赢：其他闲家应付 B × F × D胜。", "mandatory": true },
  { "ruleId": "R16-012", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付 说明1", "fromLine": 872, "toLine": 872, "text": "点炮不额外翻倍。", "mandatory": true },
  { "ruleId": "R16-013", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付 说明2", "fromLine": 873, "toLine": 873, "text": "抢杠胡“三家钱”按实际人数折算；2 人局按 1 个对手。", "mandatory": true },
  { "ruleId": "R16-014", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付 说明3", "fromLine": 874, "toLine": 874, "text": "闲家自摸时，只有庄家承担牢庄倍数，其他闲家不乘牢庄倍数。", "mandatory": true },
  { "ruleId": "R16-015", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.2 基础赔付 说明4", "fromLine": 875, "toLine": 875, "text": "以上付款金额为负值，记入付款方。", "mandatory": true },
  { "ruleId": "R16-016", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 1", "fromLine": 878, "toLine": 878, "text": "三摊承包改写仅三摊承包开启时执行。", "mandatory": true },
  { "ruleId": "R16-017", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 2", "fromLine": 879, "toLine": 879, "text": "只处理胡牌方本人参与的承包对；未参与的对不结算。", "mandatory": true },
  { "ruleId": "R16-018", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 3", "fromLine": 880, "toLine": 880, "text": "只处理庄闲对；闲闲对跳过。", "mandatory": true },
  { "ruleId": "R16-019", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 4", "fromLine": 881, "toLine": 881, "text": "点炮时只处理“放铳者 = 承包对方”的对。", "mandatory": true },
  { "ruleId": "R16-020", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 5", "fromLine": 883, "toLine": 883, "text": "胡牌方对对方 ≥3 摊（胡牌方是摊方）→ 对方承包全部输分 ×1。", "mandatory": true },
  { "ruleId": "R16-021", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 5", "fromLine": 884, "toLine": 884, "text": "对方对胡牌方 ≥3 摊（对方是摊方）→ 对方倒承包全部输分 ×2。", "mandatory": true },
  { "ruleId": "R16-022", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 5", "fromLine": 885, "toLine": 885, "text": "双向都 ≥3 摊 → 按倒承包 ×2。", "mandatory": true },
  { "ruleId": "R16-023", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 6", "fromLine": 886, "toLine": 886, "text": "无任何承包对 → 保持原付款结构。", "mandatory": true },
  { "ruleId": "R16-024", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 7", "fromLine": 887, "toLine": 887, "text": "抢杠胡：承包金额独立叠加在原付款上，不接管。", "mandatory": true },
  { "ruleId": "R16-025", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 8", "fromLine": 888, "toLine": 888, "text": "点炮、自摸：承包金额整体替换付款结构，未参与承包者不付。", "mandatory": true },
  { "ruleId": "R16-026", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 9", "fromLine": 889, "toLine": 889, "text": "承包明细随结算下发：赔付方、胡牌方、金额、承包/倒承包类型。", "mandatory": true },
  { "ruleId": "R16-027", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 10", "fromLine": 890, "toLine": 890, "text": "多个承包对同时成立时，每个承包方分别按“全部输分基数”承担，不共同分摊一份。", "mandatory": true },
  { "ruleId": "R16-028", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.3 三摊承包改写 11", "fromLine": 891, "toLine": 891, "text": "承包明细在承包计算后乘付款方自身加倍，但不随之后单局输分封顶、金币场封顶重算。", "mandatory": true },
  { "ruleId": "R16-029", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.4 加倍补乘 1", "fromLine": 894, "toLine": 894, "text": "胡牌方加倍已在基础公式中作为 D胜 乘入。", "mandatory": true },
  { "ruleId": "R16-030", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.4 加倍补乘 2", "fromLine": 895, "toLine": 895, "text": "承包改写完成后，对每个最终付款方再乘其 D付。", "mandatory": true },
  { "ruleId": "R16-031", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.4 加倍补乘 3", "fromLine": 896, "toLine": 896, "text": "承包明细金额同步乘承包商自己的 D付。", "mandatory": true },
  { "ruleId": "R16-032", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.4 加倍补乘 4", "fromLine": 897, "toLine": 897, "text": "未成为最终付款人的玩家，其自身加倍不计入承包基数。", "mandatory": true },
  { "ruleId": "R16-033", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.5 封顶", "fromLine": 900, "toLine": 900, "text": "封顶包括番型倍数封顶、单局输分封顶、金币场财富/携带封顶，分别作用于番数、单局输分和金币场真实入账。", "mandatory": true },
  { "ruleId": "R16-034", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.6 单局输分封顶 1", "fromLine": 903, "toLine": 903, "text": "单局输分封顶仅好友房配置 >0 时生效。", "mandatory": true },
  { "ruleId": "R16-035", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.6 单局输分封顶 2", "fromLine": 904, "toLine": 904, "text": "对每个付款方：本局已产生输分（含跟庄）+ 本次应付 < −上限 → 本次应付改为“−上限 − 已产生输分”。", "mandatory": true },
  { "ruleId": "R16-036", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.6 单局输分封顶 3", "fromLine": 905, "toLine": 905, "text": "记录命中封顶的座位。", "mandatory": true },
  { "ruleId": "R16-037", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.6 单局输分封顶 4", "fromLine": 906, "toLine": 906, "text": "赢家胡牌得分 = 付款方调整后带符号金额之和取负；本局总分再计入已有跟庄分。", "mandatory": true },
  { "ruleId": "R16-038", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.6 单局输分封顶 5", "fromLine": 907, "toLine": 907, "text": "边界：若胡牌前已因跟庄产生超过单局上限的亏损，按公式可能出现“正应付”，需联调确认。", "mandatory": true },
  { "ruleId": "R16-039", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.6 单局输分封顶 6", "fromLine": 908, "toLine": 908, "text": "该计算只在胡牌结算时调整本次付款，不单独截断纯流局的跟庄分。", "mandatory": true },
  { "ruleId": "R16-040", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 1", "fromLine": 911, "toLine": 911, "text": "结算第 1 步：按胡型计算基础赔付。", "mandatory": true },
  { "ruleId": "R16-041", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 2", "fromLine": 912, "toLine": 912, "text": "结算第 2 步：三摊承包/倒承包改写付款人。", "mandatory": true },
  { "ruleId": "R16-042", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 3", "fromLine": 913, "toLine": 913, "text": "结算第 3 步：付款方个人加倍补乘。", "mandatory": true },
  { "ruleId": "R16-043", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 4", "fromLine": 914, "toLine": 914, "text": "结算第 4 步：单局输分封顶。", "mandatory": true },
  { "ruleId": "R16-044", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 5", "fromLine": 915, "toLine": 915, "text": "结算第 5 步：赢家胡牌得分 = 各付款方带符号应付金额之和取负，再与已有跟庄分合并。", "mandatory": true },
  { "ruleId": "R16-045", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 6", "fromLine": 916, "toLine": 916, "text": "结算第 6 步：金币场按各视角执行财富/携带封顶。", "mandatory": true },
  { "ruleId": "R16-046", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 7", "fromLine": 917, "toLine": 917, "text": "结算第 7 步：累计跨局统计（胡牌、爆头、财飘、财神数量）。", "mandatory": true },
  { "ruleId": "R16-047", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 8", "fromLine": 918, "toLine": 918, "text": "结算第 8 步：下发小结算（使用本局结算时牢庄档位）。", "mandatory": true },
  { "ruleId": "R16-048", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 9", "fromLine": 919, "toLine": 919, "text": "结算第 9 步：逐座位写分（带当前牢庄档位）。", "mandatory": true },
  { "ruleId": "R16-049", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 10", "fromLine": 920, "toLine": 920, "text": "结算第 10 步：更新牢庄档位；下一局开局时判定庄家。", "mandatory": true },
  { "ruleId": "R16-050", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 11", "fromLine": 921, "toLine": 921, "text": "结算第 11 步：打片房判定是否进入大结算。", "mandatory": true },
  { "ruleId": "R16-051", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.7 结算顺序 12", "fromLine": 922, "toLine": 922, "text": "结算第 12 步：结束本局。", "mandatory": true },
  { "ruleId": "R16-052", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.8 流局 1", "fromLine": 927, "toLine": 927, "text": "流局不产生胡牌输赢分。", "mandatory": true },
  { "ruleId": "R16-053", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.8 流局 2", "fromLine": 928, "toLine": 928, "text": "已产生的跟庄赔付正常结算并下发。", "mandatory": true },
  { "ruleId": "R16-054", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.8 流局 3", "fromLine": 929, "toLine": 929, "text": "未完成的跟庄中断且不赔付。", "mandatory": true },
  { "ruleId": "R16-055", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.8 流局 4", "fromLine": 930, "toLine": 930, "text": "流局后按流局连庄配置决定庄家是否继续。", "mandatory": true },
  { "ruleId": "R16-056", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.8 流局 5", "fromLine": 931, "toLine": 931, "text": "流局也写分记录，保证座位齐全。", "mandatory": true },
  { "ruleId": "R16-057", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.8 流局 6", "fromLine": 932, "toLine": 932, "text": "纯流局跟庄分不经胡牌付款封顶；打片房流局不执行片数结束检查。", "mandatory": true },
  { "ruleId": "R16-058", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.9 大结算 1", "fromLine": 935, "toLine": 935, "text": "房间结束或解散时汇总各小局得分。", "mandatory": true },
  { "ruleId": "R16-059", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.9 大结算 2", "fromLine": 936, "toLine": 936, "text": "胜负按总分正负判定。", "mandatory": true },
  { "ruleId": "R16-060", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.9 大结算 3", "fromLine": 937, "toLine": 937, "text": "附加统计：胡牌次数、爆头次数、财飘次数、财神数量（手牌 + 出牌区 + 胡牌进张）。", "mandatory": true },
  { "ruleId": "R16-061", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 结算示例 前提", "fromLine": 940, "toLine": 940, "text": "4 人局，B=10，F=4，庄家 3 牢 → M=8；点炮/抢杠胡仅在三牢且对应开关开启时可触发，自摸不受牢数限制。", "mandatory": true },
  { "ruleId": "R16-062", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 结算示例 庄家自摸", "fromLine": 944, "toLine": 944, "text": "庄家自摸：每个闲家 10×4×8=320，庄家 +960，三闲各 −320。", "mandatory": true },
  { "ruleId": "R16-063", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 结算示例 闲家自摸", "fromLine": 945, "toLine": 945, "text": "闲家自摸：庄家 10×4×8=320；两闲各 10×4=40，闲家 +400，庄家 −320，两闲各 −40。", "mandatory": true },
  { "ruleId": "R16-064", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 结算示例 闲家点炮给庄家", "fromLine": 946, "toLine": 946, "text": "闲家点炮给庄家：放铳闲家 10×4×8=320，庄家 +320，放铳者 −320。", "mandatory": true },
  { "ruleId": "R16-065", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 结算示例 庄家点炮给闲家", "fromLine": 947, "toLine": 947, "text": "庄家点炮给闲家：庄家 10×4×8=320，闲家 +320，庄家 −320。", "mandatory": true },
  { "ruleId": "R16-066", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 结算示例 闲家抢庄家杠", "fromLine": 948, "toLine": 948, "text": "闲家抢庄家杠：10×4×(8+2)=400，闲家 +400，杠牌庄家 −400。", "mandatory": true },
  { "ruleId": "R16-067", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 结算示例 庄家抢闲家杠", "fromLine": 949, "toLine": 949, "text": "庄家抢闲家杠：10×4×8×(4−1)=960，庄家 +960，杠牌闲家 −960。", "mandatory": true },
  { "ruleId": "R16-068", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 承包示例", "fromLine": 952, "toLine": 952, "text": "A 对 Z 有 3 摊，A 胡牌 → Z 承包全部输分 ×1。", "mandatory": true },
  { "ruleId": "R16-069", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 承包示例", "fromLine": 953, "toLine": 953, "text": "Z 对 A 有 3 摊，A 胡牌 → Z 倒承包全部输分 ×2。", "mandatory": true },
  { "ruleId": "R16-070", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 承包示例", "fromLine": 954, "toLine": 954, "text": "A、Z 双向都满 3 摊，A 胡牌 → 按倒承包 ×2。", "mandatory": true },
  { "ruleId": "R16-071", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 承包示例", "fromLine": 955, "toLine": 955, "text": "庄家 Z 胡牌，闲家 A、B 各自对 Z 有 3 摊 → A、B 分别按全部输分 ×2 赔付，不共同分摊。", "mandatory": true },
  { "ruleId": "R16-072", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.10 加倍与承包示例", "fromLine": 957, "toLine": 957, "text": "4 人局底分 10 庄家自摸且加倍：基础每闲 40，全部输分基数 120；A 倒承包且自身加倍，A 应付 120×2×2=480。", "mandatory": true },
  { "ruleId": "R16-073", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 1", "fromLine": 964, "toLine": 964, "text": "展示结算结果：胡牌 / 流局 / 被动结束。", "mandatory": true },
  { "ruleId": "R16-074", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 2", "fromLine": 965, "toLine": 965, "text": "展示胡牌信息：胡牌玩家、胡型（自摸/点炮/抢杠）、番型名称、番数、进张、来源玩家。", "mandatory": true },
  { "ruleId": "R16-075", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 3", "fromLine": 966, "toLine": 966, "text": "展示输赢信息：每名玩家的本局得分、倍数、封顶/破产状态。", "mandatory": true },
  { "ruleId": "R16-076", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 4", "fromLine": 967, "toLine": 967, "text": "展示承包信息：承包方、被承包方、承包/倒承包类型、金额。", "mandatory": true },
  { "ruleId": "R16-077", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 5", "fromLine": 968, "toLine": 968, "text": "展示额外得分：跟庄分等；无则不展示。", "mandatory": true },
  { "ruleId": "R16-078", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 6", "fromLine": 969, "toLine": 969, "text": "展示牢庄信息：本局结算时牢庄档位与倍数。", "mandatory": true },
  { "ruleId": "R16-079", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 7", "fromLine": 970, "toLine": 970, "text": "展示加倍信息：各玩家是否加倍。", "mandatory": true },
  { "ruleId": "R16-080", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 客户端必须展示 8", "fromLine": 971, "toLine": 971, "text": "展示亮牌信息：胡牌手牌与拆解；全桌手牌、副露、剩余牌墙是否展示由产品确认。", "mandatory": true },
  { "ruleId": "R16-081", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 展示规则 1", "fromLine": 974, "toLine": 974, "text": "最终得分以结算结果为准，额外分明细不得重复计分。", "mandatory": true },
  { "ruleId": "R16-082", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 展示规则 2", "fromLine": 975, "toLine": 975, "text": "番型明细缺失时，客户端应能按胡牌明细中的番型与番数展示。", "mandatory": true },
  { "ruleId": "R16-083", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 展示规则 3", "fromLine": 976, "toLine": 976, "text": "十风赢家的胡牌手牌按出牌区字牌序列展示；全桌手牌区仍展示实际手牌。", "mandatory": true },
  { "ruleId": "R16-084", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 展示规则 4", "fromLine": 977, "toLine": 977, "text": "结算亮牌与普通重连的手牌可见性规则不同。", "mandatory": true },
  { "ruleId": "R16-085", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 展示规则 5", "fromLine": 978, "toLine": 978, "text": "结算展示使用本局结算时牢庄档位，下一局牢庄在结算后更新。", "mandatory": true },
  { "ruleId": "R16-086", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 展示规则 6", "fromLine": 979, "toLine": 979, "text": "承包明细为封顶前口径，不应直接当作最终实扣；金币场每位玩家收到自己的结算视角。", "mandatory": true },
  { "ruleId": "R16-087", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 展示规则 7", "fromLine": 980, "toLine": 980, "text": "番型倍率固定注册在算法中；结算番型明细读取另一份配置倍率，当前杭麻路径未见填入，明细可能为空。", "mandatory": true },
  { "ruleId": "R16-088", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 待确认 1", "fromLine": 983, "toLine": 983, "text": "待确认：全桌手牌、副露、剩余牌墙是否全部展示。", "mandatory": true },
  { "ruleId": "R16-089", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.11 待确认 2", "fromLine": 984, "toLine": 984, "text": "待确认：番型明细为空时，客户端是否只展示番型名称与番数。", "mandatory": true },
  { "ruleId": "R16-090", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-01", "fromLine": 990, "toLine": 990, "text": "点炮赔付：放铳者付 B×F×M×D胜；仅三牢+开关。", "mandatory": true },
  { "ruleId": "R16-091", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-02", "fromLine": 991, "toLine": 991, "text": "抢杠赔付：杠牌者付 B×F×D胜；庄赢 M×(人数−1)，闲赢 M+人数−2；仅三牢+开关。", "mandatory": true },
  { "ruleId": "R16-092", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-03", "fromLine": 992, "toLine": 992, "text": "自摸赔付：庄赢每闲付 B×F×M×D；闲赢庄付 B×F×M×D、其他闲家付 B×F×D。", "mandatory": true },
  { "ruleId": "R16-093", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-04", "fromLine": 993, "toLine": 993, "text": "承包改写：摊方胡→被摊方×1；被摊方胡→摊方×2；双向×2；点炮仅放铳者；抢杠独立叠加。", "mandatory": true },
  { "ruleId": "R16-094", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-05", "fromLine": 994, "toLine": 994, "text": "多承包对：每个承包方分别按全部基数承担；明细不随后续封顶重算；实扣以最终输赢为准。", "mandatory": true },
  { "ruleId": "R16-095", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-06", "fromLine": 995, "toLine": 995, "text": "加倍补乘：承包改写后每个最终付款方乘自身加倍倍数；胡牌方加倍已在基础公式。", "mandatory": true },
  { "ruleId": "R16-096", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-07", "fromLine": 996, "toLine": 996, "text": "单局封顶：好友房配置>0；已输+本次<−上限→本次= −上限−已输；可能正应付，需联调。", "mandatory": true },
  { "ruleId": "R16-097", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-08", "fromLine": 997, "toLine": 997, "text": "赢家合计：赢家胡牌分=各付款方带符号应付金额之和取负，再合并已有跟庄分。", "mandatory": true },
  { "ruleId": "R16-098", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-09", "fromLine": 998, "toLine": 998, "text": "跨局统计：每小局累计胡牌/爆头/财飘/财神数，供大结算。", "mandatory": true },
  { "ruleId": "R16-099", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-10", "fromLine": 999, "toLine": 999, "text": "结算展示：展示胡牌、手牌、输赢、番型、摊/承包、加倍；十风明细特殊。", "mandatory": true },
  { "ruleId": "R16-100", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-11", "fromLine": 1000, "toLine": 1000, "text": "写分：好友房写真实分；金币场按金币场写分规则；带当前牢庄。", "mandatory": true },
  { "ruleId": "R16-101", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-12", "fromLine": 1001, "toLine": 1001, "text": "更新牢庄：庄胡/流局连庄升牢；换庄重置；常规封顶三牢。", "mandatory": true },
  { "ruleId": "R16-102", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-13", "fromLine": 1002, "toLine": 1002, "text": "流局：不产生胡牌分；跟庄分保留；未完成跟庄不赔付；跟庄分不经胡牌付款封顶；不检查打片结束。", "mandatory": true },
  { "ruleId": "R16-103", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "9.12 SET-14", "fromLine": 1003, "toLine": 1003, "text": "大结算：房间结束/解散时汇总各小局得分与统计；打片触发由结算判。", "mandatory": true }
]
