[
  { "ruleId": "R18-001", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11 断线重连 1", "fromLine": 1091, "toLine": 1091, "text": "玩家重连时按当前阶段恢复对局。", "mandatory": true },
  { "ruleId": "R18-002", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11 断线重连 2", "fromLine": 1092, "toLine": 1102, "text": "各阶段恢复内容：开局信息、局数据、骰子牌墙手牌、做牌快照、洗牌座位、加倍状态、财神、听牌提示、摸打状态、结算数据。", "mandatory": true },
  { "ruleId": "R18-003", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11 断线重连 3", "fromLine": 1103, "toLine": 1103, "text": "普通重连只能看到自己的手牌；明牌开启时才展示其他玩家手牌。", "mandatory": true },
  { "ruleId": "R18-004", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11 断线重连 4", "fromLine": 1104, "toLine": 1104, "text": "空闲或已结束状态重连时，仅下发空闲场景。", "mandatory": true },
  { "ruleId": "R18-005", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-01", "fromLine": 1110, "toLine": 1110, "text": "开局重连：开局阶段补发等待、开局、门风、游戏配置、虚拟玩家信息。", "mandatory": true },
  { "ruleId": "R18-006", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-02", "fromLine": 1111, "toLine": 1111, "text": "定庄重连：定庄阶段补发局数据（局数/庄/连庄/牢庄）。", "mandatory": true },
  { "ruleId": "R18-007", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-03", "fromLine": 1112, "toLine": 1112, "text": "掷骰/发牌重连：补发骰子、牌墙、自己的手牌；明牌才含他人手牌。", "mandatory": true },
  { "ruleId": "R18-008", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-04", "fromLine": 1113, "toLine": 1113, "text": "做牌重连：做牌阶段补发做牌快照，恢复指定牌。", "mandatory": true },
  { "ruleId": "R18-009", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-05", "fromLine": 1114, "toLine": 1114, "text": "洗牌重连：洗牌阶段补发洗牌座位，恢复展示。", "mandatory": true },
  { "ruleId": "R18-010", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-06", "fromLine": 1115, "toLine": 1115, "text": "加倍重连：补发加倍状态与时钟；remain_sec 为配置时长。", "mandatory": true },
  { "ruleId": "R18-011", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-07", "fromLine": 1116, "toLine": 1116, "text": "定财神重连：补发财神及替代牌，恢复财神。", "mandatory": true },
  { "ruleId": "R18-012", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-08", "fromLine": 1117, "toLine": 1117, "text": "首摸重连：补发等待、牌墙、手牌、听牌提示，恢复提示。", "mandatory": true },
  { "ruleId": "R18-013", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-09", "fromLine": 1118, "toLine": 1118, "text": "摸打重连：补发局数据、牌墙、自己的手牌（明牌才含他人手牌）、权限、财神、牢庄、摊/承包、飘、禁手、出牌区、跟庄骰子、加倍。", "mandatory": true },
  { "ruleId": "R18-014", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "11.1 RELINK-10", "fromLine": 1119, "toLine": 1119, "text": "结算重连：补发输赢、历史分、虚拟玩家信息、加倍状态。", "mandatory": true },
  { "ruleId": "R18-015", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 规则配置", "fromLine": 1127, "toLine": 1127, "text": "规则配置：按开关展示或抑制规则提示，简洁模式影响提示。", "mandatory": true },
  { "ruleId": "R18-016", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 金币场玩家信息", "fromLine": 1128, "toLine": 1128, "text": "金币场玩家信息：显示底分、台费、房间等级。", "mandatory": true },
  { "ruleId": "R18-017", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 摊/承包变化", "fromLine": 1129, "toLine": 1129, "text": "摊/承包变化：更新摊数、承包/倒承包关系，变化即展示。", "mandatory": true },
  { "ruleId": "R18-018", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 飘", "fromLine": 1130, "toLine": 1130, "text": "飘：提示出财神玩家与飘次数。", "mandatory": true },
  { "ruleId": "R18-019", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 加倍", "fromLine": 1131, "toLine": 1131, "text": "加倍：显示加倍面板、倒计时、各玩家选择（金币场）。", "mandatory": true },
  { "ruleId": "R18-020", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 洗牌", "fromLine": 1132, "toLine": 1132, "text": "洗牌：显示洗牌提示/动画（好友房）。", "mandatory": true },
  { "ruleId": "R18-021", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 跟庄重掷骰子", "fromLine": 1133, "toLine": 1133, "text": "跟庄重掷骰子：显示骰子与赔付结果，仅跟庄摇骰。", "mandatory": true },
  { "ruleId": "R18-022", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 牢庄升级", "fromLine": 1134, "toLine": 1134, "text": "牢庄升级：显示升庄/牢庄档位（如适用）。", "mandatory": true },
  { "ruleId": "R18-023", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 重连", "fromLine": 1135, "toLine": 1135, "text": "重连：恢复当前阶段界面，手牌可见性按明牌规则。", "mandatory": true },
  { "ruleId": "R18-024", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 展示原则 1", "fromLine": 1138, "toLine": 1138, "text": "服务端提供数据，客户端展示形式按产品/UI 确认。", "mandatory": true },
  { "ruleId": "R18-025", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 展示原则 2", "fromLine": 1139, "toLine": 1139, "text": "结算以最终得分为准，额外分明细不得重复计分。", "mandatory": true },
  { "ruleId": "R18-026", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 展示原则 3", "fromLine": 1140, "toLine": 1140, "text": "规则提示受简洁模式影响；动效类展示待客户端核实。", "mandatory": true },
  { "ruleId": "R18-027", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "12.1 展示原则 4", "fromLine": 1141, "toLine": 1141, "text": "重连时仅展示自己的手牌；明牌开启时才展示其他玩家手牌。", "mandatory": true }
]
