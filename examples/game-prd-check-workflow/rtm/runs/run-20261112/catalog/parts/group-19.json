[
  {
    "ruleId": "R19-001",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 性能",
    "fromLine": 1147,
    "toLine": 1147,
    "text": "性能：单次操作响应目标 ≤200ms；结算下发目标 ≤500ms。验收/备注：目标值待产品确认。",
    "mandatory": true
  },
  {
    "ruleId": "R19-002",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 稳定性",
    "fromLine": 1148,
    "toLine": 1148,
    "text": "稳定性：单玩家掉线/超时不影响整桌；重连可恢复当前阶段。验收/备注：按重连章节验收。",
    "mandatory": true
  },
  {
    "ruleId": "R19-003",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 一致性",
    "fromLine": 1149,
    "toLine": 1149,
    "text": "一致性：写分幂等；同一局不重复结算；重连快照与实时状态一致。验收/备注：联调验证。",
    "mandatory": true
  },
  {
    "ruleId": "R19-004",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 兼容性",
    "fromLine": 1150,
    "toLine": 1150,
    "text": "兼容性：支持 2/3/4 人、好友房、金币场。验收/备注：配置组合验收。",
    "mandatory": true
  },
  {
    "ruleId": "R19-005",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 安全/风控",
    "fromLine": 1151,
    "toLine": 1151,
    "text": "安全/风控：随机发牌公平；配置仅房主/后台可改；关键操作有日志。验收/备注：防作弊待补。",
    "mandatory": true
  },
  {
    "ruleId": "R19-006",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 可观测",
    "fromLine": 1152,
    "toLine": 1152,
    "text": "可观测：关键阶段有结构化日志；结算、异常、重连有埋点。验收/备注：见数据与埋点章节。",
    "mandatory": true
  },
  {
    "ruleId": "R19-007",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 可维护",
    "fromLine": 1153,
    "toLine": 1153,
    "text": "可维护：规则配置化；新增玩法不改引擎分支。验收/备注：代码评审。",
    "mandatory": true
  },
  {
    "ruleId": "R19-008",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "13. 非功能需求 - 客户端体验",
    "fromLine": 1154,
    "toLine": 1154,
    "text": "客户端体验：听牌、禁手、飘、三摊、牢庄、结算提示可见。验收/备注：客户端待核实。",
    "mandatory": true
  },
  {
    "ruleId": "R19-009",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "14. 依赖与接口 - 客户端",
    "fromLine": 1160,
    "toLine": 1160,
    "text": "客户端依赖：协议解析、牌局展示、提示、动效、重连；风险：展示未核实。",
    "mandatory": true
  },
  {
    "ruleId": "R19-010",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "14. 依赖与接口 - 服务端 Logic",
    "fromLine": 1161,
    "toLine": 1161,
    "text": "服务端 Logic 依赖：对局流程、规则、结算、虚拟分；风险：本文主体。",
    "mandatory": true
  },
  {
    "ruleId": "R19-011",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "14. 依赖与接口 - 房间服务",
    "fromLine": 1162,
    "toLine": 1162,
    "text": "房间服务依赖：创建房间、座位、开局、结束；风险：依赖房间配置。",
    "mandatory": true
  },
  {
    "ruleId": "R19-012",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "14. 依赖与接口 - 配置中心",
    "fromLine": 1163,
    "toLine": 1163,
    "text": "配置中心依赖：好友房 JSON、金币场等级规则、入场配置；风险：配置缺失/冲突。",
    "mandatory": true
  },
  {
    "ruleId": "R19-013",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "14. 依赖与接口 - 机器人",
    "fromLine": 1164,
    "toLine": 1164,
    "text": "机器人依赖：托管、自动摸打；风险：与真实玩家分流。",
    "mandatory": true
  },
  {
    "ruleId": "R19-014",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "14. 依赖与接口 - 协议层",
    "fromLine": 1165,
    "toLine": 1165,
    "text": "协议层依赖：动作协议、结算协议、重连协议；风险：版本兼容。",
    "mandatory": true
  },
  {
    "ruleId": "R19-015",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "14. 依赖与接口 - 数据/埋点",
    "fromLine": 1166,
    "toLine": 1166,
    "text": "数据/埋点依赖：对局结果、异常、重连；风险：字段口径。",
    "mandatory": true
  }
]
