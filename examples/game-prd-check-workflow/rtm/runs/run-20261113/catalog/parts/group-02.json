[
  {
    "ruleId": "R02-001",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "某个玩家摸牌时出现；开局第一次摸牌还会连带触发发牌动画。",
    "mandatory": false
  },
  {
    "ruleId": "R02-002",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 7,
    "toLine": 7,
    "text": "自己的记牌器扣掉这张牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-003",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 8,
    "toLine": 8,
    "text": "桌面进入摸牌状态；别人摸牌时把当前操作者同步为那个人。",
    "mandatory": true
  },
  {
    "ruleId": "R02-004",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 9,
    "toLine": 9,
    "text": "记录摸到的牌；自己摸到财神时累加自己摸到财神的张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-005",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "一、数据上记录了什么（凑牌光效）",
    "fromLine": 11,
    "toLine": 11,
    "text": "简单模式、或已有财神时摸到财神/白板，不播光效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-006",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "一、数据上记录了什么（凑牌光效）",
    "fromLine": 12,
    "toLine": 12,
    "text": "凑成刻子时记录敬神（刻）特效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-007",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "一、数据上记录了什么（凑牌光效）",
    "fromLine": 13,
    "toLine": 13,
    "text": "凑成顺子、刻子、杠（不含财神参与）时记录对应牌值，稍后在自己手牌上播光效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-008",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "二、界面变化 - 手牌（自己）",
    "fromLine": 19,
    "toLine": 19,
    "text": "先把所有手牌放下，再把摸到的牌摸进来；摸牌完成后触发凑牌光效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-009",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "二、界面变化 - 手牌（其他三家）",
    "fromLine": 20,
    "toLine": 20,
    "text": "对应座位的手牌做一次摸牌动作。",
    "mandatory": true
  },
  {
    "ruleId": "R02-010",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "二、界面变化 - 自己手牌上的凑牌光效",
    "fromLine": 21,
    "toLine": 21,
    "text": "按顺子/刻子/杠的花色播放对应光效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-011",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "二、界面变化 - 桌面右侧的剩余张数",
    "fromLine": 22,
    "toLine": 22,
    "text": "刷新剩余张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-012",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "二、界面变化 - 听牌按钮",
    "fromLine": 23,
    "toLine": 23,
    "text": "自己摸牌后关闭听牌弹窗，并隐藏听牌按钮（等待新的听牌数据）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-013",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "二、界面变化 - 桌面明牌高亮",
    "fromLine": 24,
    "toLine": 24,
    "text": "摸到的牌在四家河牌、胡牌区、副露中高亮显示，并重刷财神颜色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-014",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "二、界面变化 - 复盘模式的操作按钮",
    "fromLine": 25,
    "toLine": 25,
    "text": "隐藏复盘用的操作按钮。",
    "mandatory": true
  },
  {
    "ruleId": "R02-015",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "三、连带影响",
    "fromLine": 29,
    "toLine": 29,
    "text": "自己摸牌后置上本轮已摸牌标记并清掉连续未听同花色计数；权限到达时据此决定是否播玄学/魅力特效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-016",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "三、连带影响",
    "fromLine": 30,
    "toLine": 30,
    "text": "摸牌有抓牌音效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-017",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "三、连带影响",
    "fromLine": 31,
    "toLine": 31,
    "text": "开局第一次摸牌会触发四家的发牌动画。",
    "mandatory": true
  },
  {
    "ruleId": "R02-018",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/08-摸牌.md",
    "section": "四、重连 / 回放",
    "fromLine": 35,
    "toLine": 35,
    "text": "只记录状态、手牌、记牌器、牌墙与光效数据：不摸牌、不发光效、不刷新剩余张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-019",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "任一玩家打出一张牌时出现。",
    "mandatory": false
  },
  {
    "ruleId": "R02-020",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 7,
    "toLine": 7,
    "text": "别人出牌时，自己的记牌器扣掉这张牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-021",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 8,
    "toLine": 8,
    "text": "记录该玩家托管出牌的次数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-022",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 9,
    "toLine": 9,
    "text": "记录该玩家打出的牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-023",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 10,
    "toLine": 10,
    "text": "自己出牌时从打听表取出打这张能听什么的信息并保存，然后清空打听表。",
    "mandatory": true
  },
  {
    "ruleId": "R02-024",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "一、数据上记录了什么",
    "fromLine": 11,
    "toLine": 11,
    "text": "记录最后一张出牌（重连时用于恢复箭头位置）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-025",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 手牌",
    "fromLine": 17,
    "toLine": 17,
    "text": "自己：手牌移除这张并可能重排，随后收起操作区。别人：对应手牌做打牌动作并重排。",
    "mandatory": true
  },
  {
    "ruleId": "R02-026",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 河牌区",
    "fromLine": 18,
    "toLine": 18,
    "text": "打出的牌落到该玩家河牌区；落定后播放出牌落地特效（受动画开关控制，播完自动隐藏）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-027",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 出牌放大牌面",
    "fromLine": 19,
    "toLine": 19,
    "text": "先隐藏所有放大牌；开启放大出牌且不是自己出牌时，在对应玩家位置放大显示并做财神染色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-028",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 听牌箭头",
    "fromLine": 20,
    "toLine": 20,
    "text": "自己出牌后刷新打哪张听什么的箭头；还留有打听数据则保留箭头，否则清空。",
    "mandatory": true
  },
  {
    "ruleId": "R02-029",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 听牌按钮",
    "fromLine": 21,
    "toLine": 21,
    "text": "没有听牌或已胡则隐藏听牌按钮；有听牌则显示并标记可胡状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-030",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 听牌闪光",
    "fromLine": 22,
    "toLine": 22,
    "text": "自己此前没播过听牌闪光时，播放一次手牌闪光。",
    "mandatory": true
  },
  {
    "ruleId": "R02-031",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 听牌界面（他人出牌）",
    "fromLine": 23,
    "toLine": 23,
    "text": "刷新听牌列表里各张牌的剩余张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-032",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 操作区",
    "fromLine": 24,
    "toLine": 24,
    "text": "收起吃碰杠胡按钮，隐藏多吃/多杠选择，清掉文字提示与庄家提示；已胡时恢复手牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-033",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 手牌置灰",
    "fromLine": 25,
    "toLine": 25,
    "text": "清除本回合的出牌限制置灰，手牌恢复可点。",
    "mandatory": true
  },
  {
    "ruleId": "R02-034",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "二、界面变化 - 音效",
    "fromLine": 26,
    "toLine": 26,
    "text": "播报这张牌的方言语音（真财神或白板替牌会换播报内容），并播放出牌音效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-035",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "三、连带影响",
    "fromLine": 30,
    "toLine": 30,
    "text": "自己出牌且听牌+手里只有一张财神连续未胡时累积次数，用于好运来图标切换或道具引导。",
    "mandatory": true
  },
  {
    "ruleId": "R02-036",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "三、连带影响",
    "fromLine": 31,
    "toLine": 31,
    "text": "河牌里出现财神牌时会自动染色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-037",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "三、连带影响",
    "fromLine": 32,
    "toLine": 32,
    "text": "复盘模式下会隐藏复盘操作按钮。",
    "mandatory": true
  },
  {
    "ruleId": "R02-038",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/09-出牌.md",
    "section": "四、重连 / 回放",
    "fromLine": 36,
    "toLine": 36,
    "text": "只记录记牌器、托管次数、手牌、听牌信息与最后出牌；不播动画、不放大、不刷新听牌界面、不播语音、不触发好运来累积。",
    "mandatory": true
  },
  {
    "ruleId": "R02-039",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "某个玩家吃了上家打出的牌时出现。",
    "mandatory": false
  },
  {
    "ruleId": "R02-040",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "一、数据上记录了什么",
    "fromLine": 7,
    "toLine": 7,
    "text": "桌面进入吃状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-041",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "一、数据上记录了什么",
    "fromLine": 8,
    "toLine": 8,
    "text": "在副露区记录这组牌（记录来源玩家），并按规则排序。",
    "mandatory": true
  },
  {
    "ruleId": "R02-042",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "一、数据上记录了什么",
    "fromLine": 9,
    "toLine": 9,
    "text": "清掉最后一张出牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-043",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "一、数据上记录了什么",
    "fromLine": 10,
    "toLine": 10,
    "text": "不是自己吃时，自己的记牌器扣掉被吃的牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-044",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "二、界面变化 - 出牌放大牌面",
    "fromLine": 16,
    "toLine": 16,
    "text": "隐藏所有放大牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-045",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "二、界面变化 - 吃碰杠飘动画位",
    "fromLine": 17,
    "toLine": 17,
    "text": "该座位播放吃动画，并播放吃的方言语音；播完自动隐藏。",
    "mandatory": true
  },
  {
    "ruleId": "R02-046",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "二、界面变化 - 操作区",
    "fromLine": 18,
    "toLine": 18,
    "text": "收起吃碰杠胡按钮，隐藏多吃/多杠选择，清掉文字提示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-047",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "二、界面变化 - 副露区",
    "fromLine": 19,
    "toLine": 19,
    "text": "从来源玩家河牌移除被吃的那张；在吃的玩家副露区增加这组牌；刷新副露来源箭头；手牌重排；重刷财神颜色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-048",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "二、界面变化 - 玩家头像（自己托管时）",
    "fromLine": 20,
    "toLine": 20,
    "text": "收起操作区、清提示、恢复手牌可点状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-049",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "二、界面变化 - 听牌界面（别人吃）",
    "fromLine": 21,
    "toLine": 21,
    "text": "刷新听牌列表的剩余张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-050",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "三、连带影响",
    "fromLine": 25,
    "toLine": 25,
    "text": "被吃的牌来自出牌区；不是自己吃时，吃走的三张会从自己记牌器扣除，否则听牌剩余张数会偏大。",
    "mandatory": true
  },
  {
    "ruleId": "R02-051",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "三、连带影响",
    "fromLine": 26,
    "toLine": 26,
    "text": "吃后手牌出现三缺一的待出状态，但不是单放，出牌限制的置灰逻辑对此有专门处理。",
    "mandatory": true
  },
  {
    "ruleId": "R02-052",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "三、连带影响",
    "fromLine": 27,
    "toLine": 27,
    "text": "吃/碰累计摊数由服务端另行下发（三摊更新），本消息不参与。",
    "mandatory": true
  },
  {
    "ruleId": "R02-053",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/10-吃.md",
    "section": "四、重连 / 回放",
    "fromLine": 31,
    "toLine": 31,
    "text": "只记录状态、副露、最后出牌与记牌器，不播放吃动画、不改操作区。",
    "mandatory": true
  },
  {
    "ruleId": "R02-054",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "某个玩家碰牌时出现。",
    "mandatory": false
  },
  {
    "ruleId": "R02-055",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "一、数据上记录了什么",
    "fromLine": 7,
    "toLine": 7,
    "text": "桌面进入碰状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-056",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "一、数据上记录了什么",
    "fromLine": 8,
    "toLine": 8,
    "text": "在副露区记录这组牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-057",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "一、数据上记录了什么",
    "fromLine": 9,
    "toLine": 9,
    "text": "清掉最后一张出牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-058",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "一、数据上记录了什么",
    "fromLine": 10,
    "toLine": 10,
    "text": "不是自己碰时，自己的记牌器扣掉两张（碰只消耗两张手牌）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-059",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "二、界面变化 - 出牌放大牌面",
    "fromLine": 16,
    "toLine": 16,
    "text": "隐藏所有放大牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-060",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "二、界面变化 - 吃碰杠飘动画位",
    "fromLine": 17,
    "toLine": 17,
    "text": "该座位播放碰动画，并播放碰的方言语音；播完自动隐藏。",
    "mandatory": true
  },
  {
    "ruleId": "R02-061",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "二、界面变化 - 操作区",
    "fromLine": 18,
    "toLine": 18,
    "text": "收起操作区，清掉文字提示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-062",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "二、界面变化 - 副露区",
    "fromLine": 19,
    "toLine": 19,
    "text": "从来源玩家河牌移除被碰的那张；碰的玩家副露区增加这组牌；刷新副露来源箭头；手牌重排；重刷财神颜色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-063",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "二、界面变化 - 玩家头像（自己托管时）",
    "fromLine": 20,
    "toLine": 20,
    "text": "收起操作区、清提示、恢复手牌可点状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-064",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "二、界面变化 - 听牌界面（别人碰）",
    "fromLine": 21,
    "toLine": 21,
    "text": "刷新听牌列表的剩余张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-065",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "三、连带影响",
    "fromLine": 25,
    "toLine": 25,
    "text": "摊数（吃/碰累计）由服务端计算，并通过三摊更新单独播落地动画，本消息不参与摊数逻辑。",
    "mandatory": true
  },
  {
    "ruleId": "R02-066",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "三、连带影响",
    "fromLine": 26,
    "toLine": 26,
    "text": "只有有进牌的碰才会从河牌移除牌；没有进牌的碰不会误删河牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-067",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "三、连带影响",
    "fromLine": 27,
    "toLine": 27,
    "text": "碰后待出的手牌不会被误判为单放，出牌限制的置灰逻辑对此有专门判断。",
    "mandatory": true
  },
  {
    "ruleId": "R02-068",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/11-碰.md",
    "section": "四、重连 / 回放",
    "fromLine": 31,
    "toLine": 31,
    "text": "只记录数据，不播放动画、不改操作区。",
    "mandatory": true
  },
  {
    "ruleId": "R02-069",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "某个玩家明杠、暗杠或补杠时出现。",
    "mandatory": false
  },
  {
    "ruleId": "R02-070",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据上记录了什么",
    "fromLine": 7,
    "toLine": 7,
    "text": "桌面进入杠状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-071",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据上记录了什么",
    "fromLine": 8,
    "toLine": 8,
    "text": "在副露区记录这组牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-072",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据上记录了什么",
    "fromLine": 9,
    "toLine": 9,
    "text": "明杠时清掉最后一张出牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-073",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "一、数据上记录了什么",
    "fromLine": 10,
    "toLine": 10,
    "text": "不是自己杠时，自己的记牌器扣掉这组牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-074",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化 - 操作区",
    "fromLine": 16,
    "toLine": 16,
    "text": "收起操作区，隐藏多选池与多杠选择，清提示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-075",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化 - 出牌放大牌面",
    "fromLine": 17,
    "toLine": 17,
    "text": "隐藏放大牌面。",
    "mandatory": true
  },
  {
    "ruleId": "R02-076",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化 - 吃碰杠飘动画位",
    "fromLine": 18,
    "toLine": 18,
    "text": "该座位播放杠动画；语音按类型区分：明杠、暗杠、补杠各有一条。",
    "mandatory": true
  },
  {
    "ruleId": "R02-077",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化 - 副露区（明杠 / 暗杠）",
    "fromLine": 19,
    "toLine": 19,
    "text": "新增一组副露；刷新副露来源箭头；手牌重排；重刷财神颜色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-078",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化 - 副露区（补杠）",
    "fromLine": 20,
    "toLine": 20,
    "text": "先把手里那张牌去掉，再把这张牌追加到原来的刻子上（不新增一格副露）；重刷财神颜色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-079",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化 - 玩家头像（自己托管时）",
    "fromLine": 21,
    "toLine": 21,
    "text": "收起操作区、清提示、恢复手牌可点状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-080",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "二、界面变化 - 听牌界面（别人杠）",
    "fromLine": 22,
    "toLine": 22,
    "text": "刷新听牌列表剩余张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-081",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "三、连带影响",
    "fromLine": 26,
    "toLine": 26,
    "text": "杠之后的杠牌权、杠上花、杠后听牌提示由权限和听牌信息继续处理，不在本消息里。",
    "mandatory": true
  },
  {
    "ruleId": "R02-082",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "三、连带影响",
    "fromLine": 27,
    "toLine": 27,
    "text": "暗杠时别人看不到具体牌，但记牌器仍按协议扣减。",
    "mandatory": true
  },
  {
    "ruleId": "R02-083",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "三、连带影响",
    "fromLine": 28,
    "toLine": 28,
    "text": "一次能杠好几种的多杠选择由权限消息里的多杠列表负责，本消息不涉及。",
    "mandatory": true
  },
  {
    "ruleId": "R02-084",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/12-杠.md",
    "section": "四、重连 / 回放",
    "fromLine": 32,
    "toLine": 32,
    "text": "只记录数据；补杠与普通杠在副露区的差异，重连时由恢复手牌统一还原。",
    "mandatory": true
  },
  {
    "ruleId": "R02-085",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 5,
    "text": "服务端告诉客户端当前座位可以出牌/吃/碰/杠/胡/过；这是操作区变化最集中的一条消息。",
    "mandatory": false
  },
  {
    "ruleId": "R02-086",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "一、数据上记录了什么",
    "fromLine": 9,
    "toLine": 9,
    "text": "记录当前操作者、可执行的操作、以及本次操作的询问编号。",
    "mandatory": true
  },
  {
    "ruleId": "R02-087",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "一、数据上记录了什么",
    "fromLine": 10,
    "toLine": 10,
    "text": "标记轮到出牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-088",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "一、数据上记录了什么",
    "fromLine": 11,
    "toLine": 11,
    "text": "记录机器人的自动报听预设。",
    "mandatory": true
  },
  {
    "ruleId": "R02-089",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "一、数据上记录了什么",
    "fromLine": 12,
    "toLine": 12,
    "text": "记录自己本回合是否有胡权限、听牌后连续未胡次数等，用于提示与特效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-090",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 倒计时数字",
    "fromLine": 18,
    "toLine": 18,
    "text": "显示当前操作者剩余时间；最后 3 秒换红色字体并播倒计时提示音；超过 8 秒没操作提示尽快操作。",
    "mandatory": true
  },
  {
    "ruleId": "R02-091",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 方位盘四角风向灯",
    "fromLine": 19,
    "toLine": 19,
    "text": "当前操作者对应方向的灯闪烁，其他方向熄灭；时间结束时停止。",
    "mandatory": true
  },
  {
    "ruleId": "R02-092",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 操作者头像框",
    "fromLine": 20,
    "toLine": 20,
    "text": "当前操作者头像出现循环发光框，其他座位熄灭。",
    "mandatory": true
  },
  {
    "ruleId": "R02-093",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 操作区（他人）",
    "fromLine": 21,
    "toLine": 21,
    "text": "收起自己的吃碰杠胡按钮。",
    "mandatory": true
  },
  {
    "ruleId": "R02-094",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 操作区（自己）",
    "fromLine": 22,
    "toLine": 22,
    "text": "自己操作区按下方自己操作区明细处理。",
    "mandatory": true
  },
  {
    "ruleId": "R02-095",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 听牌按钮",
    "fromLine": 23,
    "toLine": 23,
    "text": "自己有出牌权时隐藏听牌按钮；自己有胡权时关闭听牌弹窗。",
    "mandatory": true
  },
  {
    "ruleId": "R02-096",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 番型 / 规则弹窗",
    "fromLine": 24,
    "toLine": 24,
    "text": "关闭番型 / 规则弹窗。",
    "mandatory": true
  },
  {
    "ruleId": "R02-097",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 手牌置灰",
    "fromLine": 25,
    "toLine": 25,
    "text": "自己有出牌权且存在禁打数据时，把禁打的牌置灰、不可点。",
    "mandatory": true
  },
  {
    "ruleId": "R02-098",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 玩家头像（自己托管且没有任何操作权）",
    "fromLine": 26,
    "toLine": 26,
    "text": "收起操作区、清提示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-099",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 首出提示",
    "fromLine": 27,
    "toLine": 27,
    "text": "本局第一次出牌且未提示过则显示庄家首出提示（按是否庄家切换文案）、清文字提示、隐藏骰子；否则隐藏提示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-100",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 听牌闪光",
    "fromLine": 28,
    "toLine": 28,
    "text": "首出且自己不是庄家时，若有听牌则播放一次手牌闪光。",
    "mandatory": true
  },
  {
    "ruleId": "R02-101",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "二、界面变化 - 祈福弹窗",
    "fromLine": 29,
    "toLine": 29,
    "text": "按条件弹出听牌连续 3 次不胡、三次摸到同一张固定牌、杠牌不能胡等提示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-102",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 操作区状态",
    "fromLine": 35,
    "toLine": 35,
    "text": "有吃/碰/杠/胡任一项则切到吃碰杠胡页；否则从该页回到空状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-103",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 吃/碰/杠/过/过2/胡 按钮",
    "fromLine": 36,
    "toLine": 36,
    "text": "按权限显示或隐藏；报听按钮在本玩法始终隐藏。",
    "mandatory": true
  },
  {
    "ruleId": "R02-104",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 多杠列表",
    "fromLine": 37,
    "toLine": 37,
    "text": "有杠权时：只有一种杠不显示列表；有多种杠时显示牌面列表，可点击选择要杠哪种。",
    "mandatory": true
  },
  {
    "ruleId": "R02-105",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 胡按钮里的牌面",
    "fromLine": 38,
    "toLine": 38,
    "text": "显示要胡的那张牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-106",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 胡按钮里的动作动画",
    "fromLine": 39,
    "toLine": 39,
    "text": "点炮/抢杠显示胡，自摸显示自摸。",
    "mandatory": true
  },
  {
    "ruleId": "R02-107",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 胡按钮里的倍数",
    "fromLine": 40,
    "toLine": 40,
    "text": "显示 X 倍，封顶标识隐藏。",
    "mandatory": true
  },
  {
    "ruleId": "R02-108",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 手牌",
    "fromLine": 41,
    "toLine": 41,
    "text": "可出牌时手牌可点；吃/碰/杠时把相关牌拉亮、其余置灰（多组合合并亮起）；杠与刚摸的牌无关时不置灰可直接出牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-109",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 按钮光效",
    "fromLine": 42,
    "toLine": 42,
    "text": "吃/碰/杠/过/胡按钮播放按钮闪光。",
    "mandatory": true
  },
  {
    "ruleId": "R02-110",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "自己操作区明细 - 多吃选择池",
    "fromLine": 43,
    "toLine": 43,
    "text": "吃有多种组合时，在右侧动态生成多个整组顺子的选项，与多杠列表互斥显示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-111",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "三、连带影响",
    "fromLine": 47,
    "toLine": 47,
    "text": "自己刚摸过牌时，权限到达会触发玄学 / 魅力道具特效（摸牌后才有意义）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-112",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "三、连带影响",
    "fromLine": 48,
    "toLine": 48,
    "text": "轮到出牌的标记会影响做牌类界面的功能页显示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-113",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "三、连带影响",
    "fromLine": 49,
    "toLine": 49,
    "text": "权限与出牌限制有顺序要求：必须先收到出牌限制、再收到权限，手牌置灰才会正确刷新。",
    "mandatory": true
  },
  {
    "ruleId": "R02-114",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "四、重连 / 回放",
    "fromLine": 53,
    "toLine": 53,
    "text": "只记录权限与询问编号，不刷倒计时、不亮头像框、不弹操作按钮、不置灰、不弹祈福窗口；重连由场景动作补刷倒计时、方位灯和头像框。",
    "mandatory": true
  },
  {
    "ruleId": "R02-115",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/13-权限.md",
    "section": "四、重连 / 回放",
    "fromLine": 55,
    "toLine": 55,
    "text": "复盘模式改用复盘操作按钮的显示逻辑：只显示可用的按钮并加光效，不驱动倒计时与流程。",
    "mandatory": true
  },
  {
    "ruleId": "R02-116",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "服务端下发哪些手牌不能打、哪张摸上来的单放牌不能打，用于过张、吃禁手等规则。",
    "mandatory": false
  },
  {
    "ruleId": "R02-117",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "一、数据上记录了什么",
    "fromLine": 7,
    "toLine": 7,
    "text": "记录禁打的手牌牌值列表。",
    "mandatory": true
  },
  {
    "ruleId": "R02-118",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "一、数据上记录了什么",
    "fromLine": 8,
    "toLine": 8,
    "text": "记录禁打的单放（刚摸上来那张）牌值；空表示不禁单放。",
    "mandatory": true
  },
  {
    "ruleId": "R02-119",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "一、数据上记录了什么",
    "fromLine": 9,
    "toLine": 9,
    "text": "两者都为空时清空禁打数据；否则记录到当前座位名下。",
    "mandatory": true
  },
  {
    "ruleId": "R02-120",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "一、数据上记录了什么（设计约定）",
    "fromLine": 11,
    "toLine": 11,
    "text": "这条消息只记录，真正把手牌置灰是在权限消息里做的。",
    "mandatory": true
  },
  {
    "ruleId": "R02-121",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "二、界面变化 - 自己手牌",
    "fromLine": 17,
    "toLine": 17,
    "text": "有禁打数据时禁打的手牌变灰且不能点击；禁打单放只作用在最后一张摸上来的牌；其余牌恢复原本财神颜色。",
    "mandatory": true
  },
  {
    "ruleId": "R02-122",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "二、界面变化 - 自己手牌（清空禁打时）",
    "fromLine": 18,
    "toLine": 18,
    "text": "仅在当前操作者是自己时刷新一次，避免别人回合误刷自己的手牌。",
    "mandatory": true
  },
  {
    "ruleId": "R02-123",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "三、连带影响",
    "fromLine": 24,
    "toLine": 24,
    "text": "刷新财神颜色 / 手牌重新排序之后，需主动重刷一次置灰。",
    "mandatory": true
  },
  {
    "ruleId": "R02-124",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "三、连带影响",
    "fromLine": 25,
    "toLine": 25,
    "text": "权限到达之后，需主动重刷一次置灰。",
    "mandatory": true
  },
  {
    "ruleId": "R02-125",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "三、连带影响",
    "fromLine": 26,
    "toLine": 26,
    "text": "自己出牌、本回合结束时清掉置灰。",
    "mandatory": true
  },
  {
    "ruleId": "R02-126",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "三、连带影响",
    "fromLine": 28,
    "toLine": 28,
    "text": "单放判断依据是这张是刚摸上来的那张，不能用出手牌数量除 3 余 2 来判断（吃碰后待出的手牌也会余 2）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-127",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/14-出牌限制-禁打.md",
    "section": "四、重连 / 回放",
    "fromLine": 32,
    "toLine": 32,
    "text": "只记录禁打数据，不刷新手牌；重连时先补数据，再由权限步骤把置灰刷出来。",
    "mandatory": true
  },
  {
    "ruleId": "R02-128",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "什么时候出现",
    "fromLine": 3,
    "toLine": 3,
    "text": "服务端返回现在已经听什么和/或打哪张牌之后听什么，可能分多条下发。",
    "mandatory": false
  },
  {
    "ruleId": "R02-129",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "一、先理解消息内容",
    "fromLine": 7,
    "toLine": 7,
    "text": "打出牌=0 的条目表示当前已听（查听）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-130",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "一、先理解消息内容",
    "fromLine": 8,
    "toLine": 8,
    "text": "打出牌≠0 的条目表示打这张会听什么（打听）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-131",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "一、先理解消息内容",
    "fromLine": 9,
    "toLine": 9,
    "text": "标记分为开始、全部、结束；开始/全部会先清空旧的打听数据；结束/全部表示这一批收完，需要刷新界面。",
    "mandatory": true
  },
  {
    "ruleId": "R02-132",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "一、先理解消息内容",
    "fromLine": 10,
    "toLine": 10,
    "text": "代表任意牌（爆头）的特殊值会被统一成界面认识的任意牌图案。",
    "mandatory": true
  },
  {
    "ruleId": "R02-133",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "一、先理解消息内容",
    "fromLine": 11,
    "toLine": 11,
    "text": "只处理自己的数据，且自己还没胡。",
    "mandatory": true
  },
  {
    "ruleId": "R02-134",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "二、数据上记录了什么",
    "fromLine": 15,
    "toLine": 15,
    "text": "查听：记录自己当前的听牌信息，并计算箭头类型（大 / 多 / 优）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-135",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "二、数据上记录了什么",
    "fromLine": 16,
    "toLine": 16,
    "text": "打听：按要打出的牌分别记录听牌信息；收到结束时计算箭头类型。",
    "mandatory": true
  },
  {
    "ruleId": "R02-136",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "二、数据上记录了什么",
    "fromLine": 17,
    "toLine": 17,
    "text": "每张听牌的剩余张数按记牌器实时计算；任意牌固定不显示剩余张数。",
    "mandatory": true
  },
  {
    "ruleId": "R02-137",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "三、界面变化 - 听牌按钮",
    "fromLine": 23,
    "toLine": 23,
    "text": "有查听时关闭听牌弹窗、刷新手牌上的打听箭头；有听牌且未胡则显示听牌按钮并标记可胡；同时刷新托管/报听按钮状态。",
    "mandatory": true
  },
  {
    "ruleId": "R02-138",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "三、界面变化 - 自己手牌上的箭头",
    "fromLine": 24,
    "toLine": 24,
    "text": "每张打了会听的牌上出现箭头：打出财神听任意牌显示飘，其他任意牌听显示爆，其余按大/多/优显示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-139",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "三、界面变化 - 听牌列表",
    "fromLine": 25,
    "toLine": 25,
    "text": "不由本消息直接推：点击听牌按钮后，听牌界面自己读取当前听牌数据渲染（张数页、倍数与剩余张数、爆头区、封顶文案）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-140",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "三、界面变化 - 玄学 / 魅力特效",
    "fromLine": 26,
    "toLine": 26,
    "text": "判断打听是否有效，有效时交给玄学系统播放特效。",
    "mandatory": true
  },
  {
    "ruleId": "R02-141",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "三、界面变化 - 祈福弹窗",
    "fromLine": 27,
    "toLine": 27,
    "text": "收齐打听数据且有杠权、能杠爆时，弹杠牌不能胡提示。",
    "mandatory": true
  },
  {
    "ruleId": "R02-142",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "四、连带影响",
    "fromLine": 31,
    "toLine": 31,
    "text": "自己出牌时会消费打听数据：取出打这张听什么后清空打听表，所以出牌后箭头会消失。",
    "mandatory": true
  },
  {
    "ruleId": "R02-143",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "四、连带影响",
    "fromLine": 32,
    "toLine": 32,
    "text": "重连兜底：断线前若已有打哪张听什么的数据，重连时先保存、再恢复并补刷箭头；服务端随后下发的听牌信息会覆盖它。",
    "mandatory": true
  },
  {
    "ruleId": "R02-144",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "五、重连 / 回放",
    "fromLine": 36,
    "toLine": 36,
    "text": "只有查听的情况下，即使只补数据，也会刷新一次听牌按钮（保证重连后按钮能出现）。",
    "mandatory": true
  },
  {
    "ruleId": "R02-145",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/15-听牌信息.md",
    "section": "五、重连 / 回放",
    "fromLine": 37,
    "toLine": 37,
    "text": "打听数据的箭头刷新在只补数据时会被跳过。",
    "mandatory": true
  }
