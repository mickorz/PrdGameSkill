[
  { "ruleId": "R04-001", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "触发时机", "fromLine": 3, "toLine": 3, "text": "服务端下发“规则限制、操作被拒、跟庄成功”等提示时进入通知信息处理", "mandatory": true },
  { "ruleId": "R04-002", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "一、处理规则", "fromLine": 7, "toLine": 7, "text": "按提示类型区分处理", "mandatory": true },
  { "ruleId": "R04-003", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "一、处理规则", "fromLine": 8, "toLine": 8, "text": "如果这个提示客户端已经点过“知道了”，不再重复提示", "mandatory": true },
  { "ruleId": "R04-004", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "一、处理规则", "fromLine": 9, "toLine": 9, "text": "“跟庄成功”需要全桌播放跟庄动效，不按座位过滤", "mandatory": true },
  { "ruleId": "R04-005", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、界面变化", "fromLine": 15, "toLine": 15, "text": "跟庄成功：若房间规则选择“摇骰子赔付”，跳过跟庄动画，由“跟庄重扔骰子”统一表现", "mandatory": true },
  { "ruleId": "R04-006", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、界面变化", "fromLine": 15, "toLine": 15, "text": "跟庄成功：非摇骰子赔付规则下播放一次“跟庄”动画，并定位到对应玩家位置", "mandatory": true },
  { "ruleId": "R04-007", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、界面变化", "fromLine": 15, "toLine": 15, "text": "跟庄成功：简单模式下直接跳过跟庄表现", "mandatory": true },
  { "ruleId": "R04-008", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、界面变化", "fromLine": 16, "toLine": 16, "text": "自己的规则限制提示：中央文字提示出现并显示对应文案，1.3 秒后自动消失", "mandatory": true },
  { "ruleId": "R04-009", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、提示文案", "fromLine": 22, "toLine": 22, "text": "未过手碰牌提示文案为“当前未过手，无法碰牌”", "mandatory": true },
  { "ruleId": "R04-010", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、提示文案", "fromLine": 23, "toLine": 23, "text": "未过手吃胡提示文案为“当前未过手，无法吃胡”", "mandatory": true },
  { "ruleId": "R04-011", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、提示文案", "fromLine": 24, "toLine": 24, "text": "守庄规则提示文案为“守庄规则生效中”", "mandatory": true },
  { "ruleId": "R04-012", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、提示文案", "fromLine": 25, "toLine": 25, "text": "吃禁手规则提示文案为“吃禁手规则生效中”", "mandatory": true },
  { "ruleId": "R04-013", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、提示文案", "fromLine": 26, "toLine": 26, "text": "有财必拷响提示文案为“有财必拷响规则生效中”", "mandatory": true },
  { "ruleId": "R04-014", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、提示文案", "fromLine": 27, "toLine": 27, "text": "只碰不吃提示文案为“只碰不吃规则生效中”", "mandatory": true },
  { "ruleId": "R04-015", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "二、提示文案", "fromLine": 28, "toLine": 28, "text": "有财 2 番起胡提示文案为“有财2番起胡”", "mandatory": true },
  { "ruleId": "R04-016", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "三、连带影响", "fromLine": 32, "toLine": 32, "text": "定时消失的提示在显示期间，普通“清提示”不会打断它，只有强制清除才会", "mandatory": true },
  { "ruleId": "R04-017", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "三、连带影响", "fromLine": 33, "toLine": 33, "text": "“跟庄成功”与“跟庄重扔骰子”是同一表现的两种来源，注意不要重复播放", "mandatory": true },
  { "ruleId": "R04-018", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/20-通知信息.md", "section": "四、重连 / 回放", "fromLine": 37, "toLine": 37, "text": "重连/回放只补数据时不提示", "mandatory": true },

  { "ruleId": "R04-019", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/21-游戏配置.md", "section": "触发时机", "fromLine": 3, "toLine": 3, "text": "开局下发房间规则（财神类型、出牌速度、封顶倍数等）时进入游戏配置处理", "mandatory": true },
  { "ruleId": "R04-020", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/21-游戏配置.md", "section": "一、数据上记录了什么", "fromLine": 7, "toLine": 7, "text": "保存整份房间配置，之后翻财神动画、听牌界面封顶文案、结算封顶等都读这份配置", "mandatory": true },
  { "ruleId": "R04-021", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/21-游戏配置.md", "section": "二、界面变化", "fromLine": 13, "toLine": 13, "text": "自己手牌按新配置重新刷一次财神颜色：财神牌染红，置灰优先于染色，可点击、不显示角标", "mandatory": true },
  { "ruleId": "R04-022", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/21-游戏配置.md", "section": "三、连带影响", "fromLine": 17, "toLine": 17, "text": "配置决定：是否播放翻财神动画、听牌界面的封顶文案、结算封顶等", "mandatory": true },
  { "ruleId": "R04-023", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/21-游戏配置.md", "section": "三、连带影响", "fromLine": 18, "toLine": 18, "text": "重连流程通常仍执行一次本消息（非只补数据），会顺手刷新一次手牌财神颜色，属刻意行为", "mandatory": true },
  { "ruleId": "R04-024", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/21-游戏配置.md", "section": "四、重连 / 回放", "fromLine": 22, "toLine": 22, "text": "在“开局阶段重连”“旧场景开始”这类纯补数据路径里，只保存配置，不刷新手牌颜色", "mandatory": true },

  { "ruleId": "R04-025", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "触发时机", "fromLine": 3, "toLine": 3, "text": "包厢“做牌”玩法把做牌权交给某位玩家时进入做牌权限处理", "mandatory": true },
  { "ruleId": "R04-026", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "一、数据上记录了什么", "fromLine": 7, "toLine": 7, "text": "记录做牌权、当前做牌座位、本轮起始座位", "mandatory": true },
  { "ruleId": "R04-027", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "二、界面变化", "fromLine": 13, "toLine": 13, "text": "有做牌权时自动弹出做牌界面，并带上当前做牌座位", "mandatory": true },
  { "ruleId": "R04-028", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "二、做牌界面内容", "fromLine": 19, "toLine": 19, "text": "候选牌池：按牌值升序排列的候选牌，可滑动多选", "mandatory": true },
  { "ruleId": "R04-029", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "二、做牌界面内容", "fromLine": 20, "toLine": 20, "text": "做牌座位文本：显示当前是谁在做牌（本地座位号）", "mandatory": true },
  { "ruleId": "R04-030", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "二、做牌界面内容", "fromLine": 21, "toLine": 21, "text": "已选张数：显示“已选：N 张”", "mandatory": true },
  { "ruleId": "R04-031", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "二、做牌界面内容", "fromLine": 22, "toLine": 22, "text": "功能页：根据当前是否处于“出牌步”，切换做手牌/摸打/删牌墙等按钮组", "mandatory": true },
  { "ruleId": "R04-032", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "二、做牌界面内容", "fromLine": 23, "toLine": 23, "text": "选中效果：被选中的牌变灰，取消后恢复原样", "mandatory": true },
  { "ruleId": "R04-033", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "三、连带影响", "fromLine": 27, "toLine": 27, "text": "确认后把选好的牌发给服务端，并把做牌权交给下一位（或结束做牌），随后服务端下发“做牌数据”", "mandatory": true },
  { "ruleId": "R04-034", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "三、连带影响", "fromLine": 28, "toLine": 28, "text": "“做牌权限”负责打开界面，“做牌数据”负责填充牌池；顺序可能互换，界面打开时读取最新数据", "mandatory": true },
  { "ruleId": "R04-035", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "四、注意", "fromLine": 32, "toLine": 32, "text": "没有做牌权时不会弹界面", "mandatory": true },
  { "ruleId": "R04-036", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/22-做牌权限.md", "section": "四、注意", "fromLine": 33, "toLine": 33, "text": "重连到做牌阶段时，会按“做牌数据 → 做牌权限”的顺序重新弹出做牌界面，这是预期行为", "mandatory": true },

  { "ruleId": "R04-037", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/23-做牌数据.md", "section": "触发时机", "fromLine": 3, "toLine": 3, "text": "下发可用于做牌的候选牌列表时进入做牌数据处理", "mandatory": true },
  { "ruleId": "R04-038", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/23-做牌数据.md", "section": "一、数据上记录了什么", "fromLine": 7, "toLine": 7, "text": "保存候选牌列表", "mandatory": true },
  { "ruleId": "R04-039", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/23-做牌数据.md", "section": "二、界面变化", "fromLine": 13, "toLine": 13, "text": "自己有做牌权：打开做牌界面并显示候选牌池（升序、可滑动多选），同时显示做牌座位、已选张数、对应功能页", "mandatory": true },
  { "ruleId": "R04-040", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/23-做牌数据.md", "section": "二、界面变化", "fromLine": 14, "toLine": 14, "text": "自己没有做牌权：只保存数据，不打开界面", "mandatory": true },
  { "ruleId": "R04-041", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/23-做牌数据.md", "section": "三、连带影响", "fromLine": 18, "toLine": 18, "text": "界面渲染发生在“打开做牌界面”那一刻，因此“候选牌先到、权限后到”也能正确显示最新牌池", "mandatory": true },
  { "ruleId": "R04-042", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/23-做牌数据.md", "section": "三、连带影响", "fromLine": 19, "toLine": 19, "text": "重连到做牌阶段时这条消息会真实执行，因此会弹出做牌界面；若希望重连不弹，需改重连流程而非本消息", "mandatory": true },
  { "ruleId": "R04-043", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/23-做牌数据.md", "section": "四、注意", "fromLine": 23, "toLine": 23, "text": "本消息没有“只补数据”分支，任何调用路径下都会尝试打开做牌界面", "mandatory": true },

  { "ruleId": "R04-044", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "涉及界面", "fromLine": 3, "toLine": 3, "text": "玩家头像层普通房与匹配场各有一套，节点结构类似，匹配场另有“匹配分数”", "mandatory": true },
  { "ruleId": "R04-045", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "概述", "fromLine": 5, "toLine": 5, "text": "头像上昵称、累计分、庄标、加倍、准备、托管/离线、预约洗牌角标等多为桌子服务维护，由“跨层通知”触发更新而非游戏消息", "mandatory": true },
  { "ruleId": "R04-046", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 11, "toLine": 11, "text": "玩家进入：刷新昵称、累计分、头像、头像框、真人语音状态、离线倒计时、托管角标并显示头像；未开局刷新准备状态；通知玄学头像组件“玩家进入”", "mandatory": true },
  { "ruleId": "R04-047", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 12, "toLine": 12, "text": "玩家数据刷新：只刷新昵称、头像、头像框", "mandatory": true },
  { "ruleId": "R04-048", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 13, "toLine": 13, "text": "玩家离开：清空该座位头像信息与准备状态、隐藏萧山可变庄标、通知玄学头像组件“玩家离开”", "mandatory": true },
  { "ruleId": "R04-049", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 14, "toLine": 14, "text": "玩家准备/状态变化：未开局时刷新准备状态；同步预约洗牌角标", "mandatory": true },
  { "ruleId": "R04-050", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 15, "toLine": 15, "text": "预约洗牌（本人或他人使用道具）：显示/隐藏该座位的“预约洗牌”文字动画与角标", "mandatory": true },
  { "ruleId": "R04-051", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 16, "toLine": 16, "text": "换座（随机座位）：除自己外，所有头像飞向屏幕中央 → 换位 → 飞回", "mandatory": true },
  { "ruleId": "R04-052", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 17, "toLine": 17, "text": "VIP 展示气泡：该座位显示/隐藏 VIP 气泡，可点击跳转", "mandatory": true },
  { "ruleId": "R04-053", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 18, "toLine": 18, "text": "聊天/方言聊天：只播放对应语音（按性别切换男声/女声），不改节点", "mandatory": true },
  { "ruleId": "R04-054", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 19, "toLine": 19, "text": "微信授权红点：显示/隐藏红点", "mandatory": true },
  { "ruleId": "R04-055", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 20, "toLine": 20, "text": "人数变化：切换头像人数页，重新绑定每个座位对应的头像节点与准备标记", "mandatory": true },
  { "ruleId": "R04-056", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 21, "toLine": 21, "text": "入座/准备状态标记：显示“已准备/已坐下”，出牌或无效状态则隐藏", "mandatory": true },
  { "ruleId": "R04-057", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 22, "toLine": 22, "text": "头像整体显隐：进入动画期间隐藏其他界面；指定玩家显示/隐藏头像；自己头像可单独显示/隐藏", "mandatory": true },
  { "ruleId": "R04-058", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 23, "toLine": 23, "text": "自己头像位置：自由态与局内两种位置切换（坐下时位置不同），并通知公共层自己的头像位置变了", "mandatory": true },
  { "ruleId": "R04-059", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 24, "toLine": 24, "text": "开局安全校验：清空全桌准备状态", "mandatory": true },
  { "ruleId": "R04-060", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 25, "toLine": 25, "text": "游戏结果返回：延迟 1.2 秒后，把“已坐下”的座位重新显示准备状态", "mandatory": true },
  { "ruleId": "R04-061", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "一、外部通知与头像变化对照", "fromLine": 26, "toLine": 26, "text": "托管弹窗打开成功：取消自己的自动托管、隐藏托管蒙层、强制刷新头像", "mandatory": true },
  { "ruleId": "R04-062", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "二、游戏服务负责的头像变化", "fromLine": 30, "toLine": 36, "text": "游戏服务负责的头像变化索引：庄家标记/连庄档位、加倍标记、当前操作者发光框、累计分刷新、桌面动作表现（其余文档详述）", "mandatory": false },
  { "ruleId": "R04-063", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "三、注意", "fromLine": 40, "toLine": 40, "text": "普通房与匹配场是两套头像界面，通知名相同但节点不同；改一个头像表现时两处都要检查", "mandatory": true },
  { "ruleId": "R04-064", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "三、注意", "fromLine": 41, "toLine": 41, "text": "头像“加倍常驻标记”与桌面“加倍标签”是两套：桌面标签阶段结束即清，头像标记保留到下一局重置", "mandatory": true },
  { "ruleId": "R04-065", "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/40-玩家头像的外部触发.md", "section": "三、注意", "fromLine": 42, "toLine": 42, "text": "头像进入时判断“是否已开局”：已开局就不显示准备状态，避免局中出现“已准备”", "mandatory": true }
]
