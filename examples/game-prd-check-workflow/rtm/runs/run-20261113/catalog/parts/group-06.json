[
  {
    "ruleId": "R06-001",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "触发条件",
    "fromLine": 3,
    "toLine": 3,
    "text": "玩家在开局准备阶段（开局倒计时中）断线后重连时走本流程",
    "mandatory": true
  },
  {
    "ruleId": "R06-002",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "一、1",
    "fromLine": 7,
    "toLine": 7,
    "text": "补齐开局数据：牌墙总数、记牌器、底分、托管时间等，且不触发界面",
    "mandatory": true
  },
  {
    "ruleId": "R06-003",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "一、2",
    "fromLine": 8,
    "toLine": 8,
    "text": "补齐匹配场底分，且不触发界面",
    "mandatory": true
  },
  {
    "ruleId": "R06-004",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "一、3",
    "fromLine": 9,
    "toLine": 9,
    "text": "游戏配置：保存配置，并刷新自己手牌的财神颜色",
    "mandatory": true
  },
  {
    "ruleId": "R06-005",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、主界面操作区",
    "fromLine": 15,
    "toLine": 15,
    "text": "操作区回到空状态；隐藏出牌放大牌面；清掉多吃/多杠选择与复盘按钮；清掉文字提示与庄家提示",
    "mandatory": true
  },
  {
    "ruleId": "R06-006",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、自己手牌",
    "fromLine": 16,
    "toLine": 16,
    "text": "自己手牌清空，并重刷财神颜色",
    "mandatory": true
  },
  {
    "ruleId": "R06-007",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、听牌按钮",
    "fromLine": 17,
    "toLine": 17,
    "text": "听牌按钮与听牌祈福按钮隐藏",
    "mandatory": true
  },
  {
    "ruleId": "R06-008",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、剩余张数",
    "fromLine": 18,
    "toLine": 18,
    "text": "剩余张数隐藏",
    "mandatory": true
  },
  {
    "ruleId": "R06-009",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、胡牌方式标记",
    "fromLine": 19,
    "toLine": 19,
    "text": "胡牌方式标记全部隐藏",
    "mandatory": true
  },
  {
    "ruleId": "R06-010",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、桌面牌面",
    "fromLine": 20,
    "toLine": 20,
    "text": "清空四家手牌、河牌、副露、胡牌区；隐藏河牌箭头、倒计时与两枚骰子；还原自己手牌位置与大小；隐藏桌面财神牌与剩余张数",
    "mandatory": true
  },
  {
    "ruleId": "R06-011",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、出牌落地特效",
    "fromLine": 21,
    "toLine": 21,
    "text": "出牌落地与胡牌落地特效全部隐藏",
    "mandatory": true
  },
  {
    "ruleId": "R06-012",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、玩家头像区",
    "fromLine": 22,
    "toLine": 22,
    "text": "清除加倍标记、庄家标记、头像发光框与未执行定时任务；保留其他玩家头像（由桌子服务恢复）",
    "mandatory": true
  },
  {
    "ruleId": "R06-013",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、提示动画层",
    "fromLine": 23,
    "toLine": 23,
    "text": "清空开局动画、庄家提示、飘分、匹配结果、随机座位提示；停止各类动画；清文字提示；结束类型归零",
    "mandatory": true
  },
  {
    "ruleId": "R06-014",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "二、小结算界面",
    "fromLine": 24,
    "toLine": 24,
    "text": "小结算界面关闭",
    "mandatory": true
  },
  {
    "ruleId": "R06-015",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "三、连带影响",
    "fromLine": 28,
    "toLine": 28,
    "text": "本步作用是把上一局残留清干净；本局数据由后续重连流程（场景动作等）重新写入",
    "mandatory": true
  },
  {
    "ruleId": "R06-016",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "三、连带影响",
    "fromLine": 29,
    "toLine": 29,
    "text": "若消息带有等待确认，立即回应服务端，避免卡在开局等待",
    "mandatory": true
  },
  {
    "ruleId": "R06-017",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "三、连带影响",
    "fromLine": 30,
    "toLine": 30,
    "text": "此处会清空手牌数据，重连顺序上必须由后续恢复手牌/恢复河牌补回，否则桌面会空",
    "mandatory": true
  },
  {
    "ruleId": "R06-018",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/30-重连-开局阶段.md",
    "section": "四、与其他重连的关系",
    "fromLine": 34,
    "toLine": 34,
    "text": "不同断线阶段走不同重连消息（准备、对局中、做牌、加倍、洗牌、结算各有入口），本消息为服务端单独下发开局重连的兼容路径",
    "mandatory": false
  },
  {
    "ruleId": "R06-019",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "触发条件",
    "fromLine": 3,
    "toLine": 3,
    "text": "旧版本在开局状态断线重连时下发；新协议已不再发送，仅兼容旧对局快照",
    "mandatory": true
  },
  {
    "ruleId": "R06-020",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "一、1",
    "fromLine": 7,
    "toLine": 7,
    "text": "补齐开局数据与表现（同开局说明）",
    "mandatory": true
  },
  {
    "ruleId": "R06-021",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "一、2",
    "fromLine": 8,
    "toLine": 8,
    "text": "匹配场底分只补数据",
    "mandatory": true
  },
  {
    "ruleId": "R06-022",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "一、3",
    "fromLine": 9,
    "toLine": 9,
    "text": "游戏配置：保存配置并刷新手牌财神颜色",
    "mandatory": true
  },
  {
    "ruleId": "R06-023",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "一、4",
    "fromLine": 10,
    "toLine": 10,
    "text": "等待确认：记录编号，必要时自动回应服务端",
    "mandatory": true
  },
  {
    "ruleId": "R06-024",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "二、总述",
    "fromLine": 14,
    "toLine": 14,
    "text": "本消息自身没有额外的界面动作，所有变化都来自内部依次补齐的几项",
    "mandatory": true
  },
  {
    "ruleId": "R06-025",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "二、开局来源",
    "fromLine": 18,
    "toLine": 18,
    "text": "操作区收起；匹配倒计时隐藏；四家加倍标记/庄家标记/头像发光框清空；背景切到游戏中状态；开局动画按局数决定；剩余张数刷新",
    "mandatory": true
  },
  {
    "ruleId": "R06-026",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "二、游戏配置来源",
    "fromLine": 19,
    "toLine": 19,
    "text": "自己手牌财神颜色刷新",
    "mandatory": true
  },
  {
    "ruleId": "R06-027",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "二、等待确认来源",
    "fromLine": 20,
    "toLine": 20,
    "text": "等待确认一般无可见变化（自动回应服务端）",
    "mandatory": true
  },
  {
    "ruleId": "R06-028",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "三、注意",
    "fromLine": 24,
    "toLine": 24,
    "text": "开局这一步不是只补数据方式执行，旧快照重连会尝试播放开局动画；若记录里不是第一局则不播",
    "mandatory": true
  },
  {
    "ruleId": "R06-029",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/31-重连-场景开始旧协议.md",
    "section": "三、注意",
    "fromLine": 25,
    "toLine": 25,
    "text": "新流程请使用场景动作或重连开局阶段",
    "mandatory": false
  },
  {
    "ruleId": "R06-030",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/32-重连-场景做牌.md",
    "section": "触发条件",
    "fromLine": 3,
    "toLine": 3,
    "text": "做牌阶段断线后重连时走本流程",
    "mandatory": true
  },
  {
    "ruleId": "R06-031",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/32-重连-场景做牌.md",
    "section": "一、标题",
    "fromLine": 5,
