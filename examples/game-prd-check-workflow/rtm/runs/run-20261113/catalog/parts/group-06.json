    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、1",
    "fromLine": 7,
    "toLine": 7,
    "text": "开局数据只补数据",
    "mandatory": true
  },
  {
    "ruleId": "R06-051",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、2",
    "fromLine": 8,
    "toLine": 8,
    "text": "匹配场底分只补数据",
    "mandatory": true
  },
  {
    "ruleId": "R06-052",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、3",
    "fromLine": 9,
    "toLine": 9,
