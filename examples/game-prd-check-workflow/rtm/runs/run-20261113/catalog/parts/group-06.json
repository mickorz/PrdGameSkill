    "mandatory": true
  },
  {
    "ruleId": "R06-053",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、4",
    "fromLine": 10,
    "toLine": 10,
    "text": "局数据：庄家与方位",
    "mandatory": true
  },
  {
    "ruleId": "R06-054",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、5",
    "fromLine": 11,
    "toLine": 11,
