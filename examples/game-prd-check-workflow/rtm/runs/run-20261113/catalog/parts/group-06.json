    "mandatory": true
  },
  {
    "ruleId": "R06-055",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、6",
    "fromLine": 12,
    "toLine": 12,
    "text": "恢复牌墙（含剩余张数）",
    "mandatory": true
  },
  {
    "ruleId": "R06-056",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、7",
    "fromLine": 13,
    "toLine": 13,
    "text": "恢复手牌（四家手牌与副露）",
    "mandatory": true
  },
  {
    "ruleId": "R06-057",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "一、末段",
    "fromLine": 15,
    "toLine": 15,
    "text": "最后若有等待确认，立即回应服务端",
    "mandatory": true
  },
  {
    "ruleId": "R06-058",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "二、玩家头像",
    "fromLine": 21,
    "toLine": 21,
    "text": "玩家头像显示庄家标记",
    "mandatory": true
  },
  {
    "ruleId": "R06-059",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "二、牌桌中央",
    "fromLine": 22,
    "toLine": 22,
    "text": "牌桌中央显示方位盘底图与四角风向灯、骰子静态点数、剩余张数",
    "mandatory": true
  },
  {
    "ruleId": "R06-060",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "二、手牌与副露",
    "fromLine": 23,
    "toLine": 23,
    "text": "四家手牌恢复并排序（财神靠左）；副露恢复并恢复来源箭头；重刷财神颜色",
    "mandatory": true
  },
  {
    "ruleId": "R06-061",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "二、自己手牌",
    "fromLine": 24,
    "toLine": 24,
    "text": "自己手牌财神颜色刷新",
    "mandatory": true
  },
  {
    "ruleId": "R06-062",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/33-重连-场景发牌旧协议.md",
    "section": "三、与场景动作的区别",
    "fromLine": 28,
    "toLine": 28,
    "text": "相比场景动作没有恢复河牌、出牌限制与权限、倒计时，可能河牌空白/无按钮/无倒计时，属已知限制仅兼容旧快照",
    "mandatory": true
  },
  {
    "ruleId": "R06-063",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "触发条件",
    "fromLine": 3,
    "toLine": 3,
    "text": "对局进行中断线后重连走这里：庄家摸牌、下家摸牌、自己摸牌、首个等待、跟庄骰子等准备阶段后的断线场景",
    "mandatory": true
  },
  {
    "ruleId": "R06-064",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、标题",
    "fromLine": 5,
    "toLine": 5,
    "text": "内部依次补齐的内容顺序非常关键",
    "mandatory": true
  },
  {
    "ruleId": "R06-065",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、1",
    "fromLine": 7,
    "toLine": 7,
    "text": "开局数据只补数据",
    "mandatory": true
  },
  {
    "ruleId": "R06-066",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、2",
    "fromLine": 8,
    "toLine": 8,
    "text": "游戏配置：刷新自己手牌财神颜色",
    "mandatory": true
  },
  {
    "ruleId": "R06-067",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、3",
    "fromLine": 9,
    "toLine": 9,
    "text": "局数据：庄家标记、方位盘",
    "mandatory": true
  },
  {
    "ruleId": "R06-068",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、4",
    "fromLine": 10,
    "toLine": 10,
    "text": "恢复牌墙：牌墙数据与剩余张数",
    "mandatory": true
  },
  {
    "ruleId": "R06-069",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、5",
    "fromLine": 11,
    "toLine": 11,
    "text": "恢复财神必须先于手牌，否则手牌排序不知财神是哪张，财神不会靠左",
    "mandatory": true
  },
  {
    "ruleId": "R06-070",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、6",
    "fromLine": 12,
    "toLine": 12,
    "text": "恢复手牌：四家手牌、副露（财神已就位）",
    "mandatory": true
  },
  {
    "ruleId": "R06-071",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、7",
    "fromLine": 13,
    "toLine": 13,
    "text": "恢复河牌：四家河牌、出牌箭头、出牌放大",
    "mandatory": true
  },
  {
    "ruleId": "R06-072",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、8",
    "fromLine": 14,
    "toLine": 14,
    "text": "恢复杭州麻将专属字段：牢庄等级、摊信息、加倍状态、飘计数、出牌限制（只补数据）",
    "mandatory": true
  },
  {
    "ruleId": "R06-073",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、9",
    "fromLine": 15,
    "toLine": 15,
    "text": "权限必须晚于出牌限制：操作按钮、倒计时、头像框，并按出牌限制刷手牌置灰",
    "mandatory": true
  },
  {
    "ruleId": "R06-074",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、10",
    "fromLine": 16,
    "toLine": 16,
    "text": "恢复倒计时与方位灯、操作者头像框",
    "mandatory": true
  },
  {
    "ruleId": "R06-075",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "一、11",
    "fromLine": 17,
    "toLine": 17,
    "text": "若有等待确认，立即回应服务端",
    "mandatory": true
  },
  {
    "ruleId": "R06-076",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "二、背景",
    "fromLine": 23,
    "toLine": 23,
    "text": "背景显示底分、牌桌美术字、游戏中状态页",
    "mandatory": true
  },
  {
    "ruleId": "R06-077",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "二、牌桌中央",
    "fromLine": 24,
    "toLine": 24,
    "text": "牌桌中央：方位盘底图、四角风向灯（含闪烁）、倒计时数字、两侧财神牌与剩余张数",
    "mandatory": true
  },
  {
    "ruleId": "R06-078",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "二、牌桌牌面",
    "fromLine": 25,
    "toLine": 25,
    "text": "四家手牌与副露、四家河牌、河牌箭头、出牌放大牌面；财神统一染色；自己手牌财神靠左",
    "mandatory": true
  },
  {
    "ruleId": "R06-079",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "二、玩家头像",
    "fromLine": 26,
    "toLine": 26,
    "text": "玩家头像显示庄家标记与当前操作者的头像发光框",
    "mandatory": true
  },
  {
    "ruleId": "R06-080",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "二、操作区",
    "fromLine": 27,
    "toLine": 27,
    "text": "操作区：吃碰杠胡按钮、多杠列表、操作区状态页、手牌可出/置灰",
    "mandatory": true
  },
  {
    "ruleId": "R06-081",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "二、加倍",
    "fromLine": 28,
    "toLine": 28,
    "text": "加倍：显示头像与桌面的加倍标记",
    "mandatory": true
  },
  {
    "ruleId": "R06-082",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "二、骰子",
    "fromLine": 29,
    "toLine": 29,
    "text": "骰子保持隐藏（对局中不应显示）",
    "mandatory": true
  },
  {
    "ruleId": "R06-083",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "三、顺序依赖一",
    "fromLine": 33,
    "toLine": 33,
    "text": "财神必须比手牌先恢复，否则财神不靠左",
    "mandatory": true
  },
  {
    "ruleId": "R06-084",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "三、顺序依赖二",
    "fromLine": 34,
    "toLine": 34,
    "text": "出牌限制必须比权限先执行，否则手牌置灰不会出现",
    "mandatory": true
  },
  {
    "ruleId": "R06-085",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "三、注意",
    "fromLine": 35,
    "toLine": 35,
    "text": "出牌限制重连时只补数据，靠权限这一步刷灰；若权限也改成只补数据，置灰会丢失",
    "mandatory": true
  },
  {
    "ruleId": "R06-086",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "三、注意",
    "fromLine": 36,
    "toLine": 36,
    "text": "本流程不恢复胡牌标记与摊牌，胡牌状态重连由结算场景与回放流程负责",
    "mandatory": true
  },
  {
    "ruleId": "R06-087",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/34-重连-场景动作.md",
    "section": "三、注意",
    "fromLine": 37,
    "toLine": 37,
    "text": "倒计时与头像框按当前操作者恢复，重连后不会错误地落在自己身上",
    "mandatory": true
  },
  {
    "ruleId": "R06-088",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "触发条件",
    "fromLine": 3,
    "toLine": 3,
    "text": "结算阶段断线后重连时走本流程",
    "mandatory": true
  },
  {
    "ruleId": "R06-089",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "一、1",
    "fromLine": 7,
    "toLine": 7,
    "text": "用结算后的累计分覆盖玩家的累计分",
    "mandatory": true
  },
  {
    "ruleId": "R06-090",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "一、2",
    "fromLine": 8,
    "toLine": 8,
    "text": "遍历每家本局得失分，只用于刷新头像，不单独保存",
    "mandatory": true
  },
  {
    "ruleId": "R06-091",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "一、3",
    "fromLine": 9,
    "toLine": 9,
    "text": "恢复加倍状态，并标记加倍阶段已结束",
    "mandatory": true
  },
  {
    "ruleId": "R06-092",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "二、玩家头像分数",
    "fromLine": 15,
    "toLine": 15,
    "text": "刷新累计分；匹配场另外刷新匹配分数文本（含数字缩写与颜色）",
    "mandatory": true
  },
  {
    "ruleId": "R06-093",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "二、加倍标记",
    "fromLine": 16,
    "toLine": 16,
    "text": "头像常驻加倍标记与桌面加倍标签；标记已结束则操作区收起、倒计时隐藏、桌面标签延迟1秒清除",
    "mandatory": true
  },
  {
    "ruleId": "R06-094",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "三、连带影响",
    "fromLine": 20,
    "toLine": 20,
    "text": "结算界面（小结算/总战绩）不由这条消息打开，重连到结算阶段时依赖公共结算流程",
    "mandatory": true
  },
  {
    "ruleId": "R06-095",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "三、连带影响",
    "fromLine": 21,
    "toLine": 21,
    "text": "本局得失分只刷新头像，不写桌面飘分数据，重连后桌面不再出现飘分数字（已知差异）",
    "mandatory": true
  },
  {
    "ruleId": "R06-096",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "四、注意",
    "fromLine": 25,
    "toLine": 25,
    "text": "头像累计分与本局得失分是两个不同来源，不要混用",
    "mandatory": true
  },
  {
    "ruleId": "R06-097",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/35-重连-场景结算.md",
    "section": "四、注意",
    "fromLine": 26,
    "toLine": 26,
    "text": "本消息没有只补数据的分支",
    "mandatory": true
  },
  {
    "ruleId": "R06-098",
    "file": ".claude/skills/game-prd-check/references/rules/hzmj_game_flow_handler/hzmj_game_flow_handler/36-重连-场景加倍.md",
    "section": "触发条件",
    "fromLine": 3,
    "toLine": 3,
