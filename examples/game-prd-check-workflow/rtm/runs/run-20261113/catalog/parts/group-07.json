  },
  {
    "ruleId": "R07-039",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "2 玩家场景地图",
    "fromLine": 156,
    "toLine": 156,
    "text": "场景-响应他人：对他人出牌决策；功能含胡、碰、杠、吃、过",
