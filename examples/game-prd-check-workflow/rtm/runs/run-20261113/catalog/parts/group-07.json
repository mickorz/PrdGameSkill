  },
  {
    "ruleId": "R07-026",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "1.8 阅读约定与功能点索引",
    "fromLine": 121,
    "toLine": 121,
    "text": "跨动作共用规则（摊/承包、跟庄、十风、杠链、飘、禁手）在特殊规则章节统一定义；动作表只列本动作触发与影响",
