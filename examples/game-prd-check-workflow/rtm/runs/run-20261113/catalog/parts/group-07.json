  },
  {
    "ruleId": "R07-025",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "1.8 阅读约定与功能点索引",
    "fromLine": 120,
    "toLine": 120,
    "text": "标注【待确认】【待核实】的内容不作为验收通过依据",
