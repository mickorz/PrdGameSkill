  },
  {
    "ruleId": "R07-040",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "2 玩家场景地图",
    "fromLine": 157,
    "toLine": 157,
    "text": "场景-特殊牌局：处理特殊规则；功能含飘、十风、三摊承包、跟庄、守庄、禁手、牢庄",
    "mandatory": true
  },
  {
    "ruleId": "R07-041",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
