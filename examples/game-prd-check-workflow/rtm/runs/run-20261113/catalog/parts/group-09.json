[
  { "ruleId": "R09-001", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.1 开局准备", "fromLine": 283, "toLine": 283, "text": "好友房杭麻游戏配置消息下发有财必拷响、三摊承包、简洁模式和局 ID", "mandatory": true },
  { "ruleId": "R09-002", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.1 开局准备", "fromLine": 283, "toLine": 283, "text": "其余配置的客户端获取途径【待核实】", "mandatory": true },
  { "ruleId": "R09-003", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.1 开局准备", "fromLine": 284, "toLine": 284, "text": "金币场下发本局游戏配置、虚拟玩家信息（底分、台费、房间等级）", "mandatory": true },
  { "ruleId": "R09-004", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 288, "toLine": 288, "text": "进入阶段时清空全桌加倍选择（仅金币场）", "mandatory": true },
  { "ruleId": "R09-005", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 289, "toLine": 289, "text": "每个座位下发独立倒计时，默认 10 秒", "mandatory": true },
  { "ruleId": "R09-006", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 290, "toLine": 290, "text": "玩家可提交“加倍”或“不加倍”", "mandatory": true },
  { "ruleId": "R09-007", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 290, "toLine": 290, "text": "重复提交无效", "mandatory": true },
  { "ruleId": "R09-008", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 290, "toLine": 290, "text": "座位号不匹配无效", "mandatory": true },
  { "ruleId": "R09-009", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 291, "toLine": 291, "text": "超时未提交 → 按“不加倍”处理", "mandatory": true },
  { "ruleId": "R09-010", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 292, "toLine": 292, "text": "断线玩家不立即处理，等待倒计时结束按“不加倍”处理", "mandatory": true },
  { "ruleId": "R09-011", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 293, "toLine": 293, "text": "全员完成选择 → 广播阶段结束，固定停 1 秒 → 进入定庄", "mandatory": true },
  { "ruleId": "R09-012", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.2 加倍（仅金币场）", "fromLine": 294, "toLine": 294, "text": "加倍开关关闭 → 直接跳过", "mandatory": true },
  { "ruleId": "R09-013", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.3 定庄", "fromLine": 299, "toLine": 299, "text": "首局：首局庄家来源 0 随机座位；1 房主", "mandatory": true },
  { "ruleId": "R09-014", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.3 定庄", "fromLine": 300, "toLine": 300, "text": "非首局·流局：流局连庄开→庄家不变且连庄+1；关→逆时针轮换下一位", "mandatory": true },
  { "ruleId": "R09-015", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.3 定庄", "fromLine": 301, "toLine": 301, "text": "非首局·胡牌·赢家坐庄：赢家坐庄；原庄自胡视为连庄", "mandatory": true },
  { "ruleId": "R09-016", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.3 定庄", "fromLine": 302, "toLine": 302, "text": "非首局·胡牌·逆时针轮换：庄家单人胡牌（含自摸、接炮、抢杠）连庄；闲家胡牌轮换下一位", "mandatory": true },
  { "ruleId": "R09-017", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.3 定庄", "fromLine": 305, "toLine": 305, "text": "首局定庄同时设置首局庄、连庄数 1、牢庄档位为起算档位", "mandatory": true },
  { "ruleId": "R09-018", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.3 定庄", "fromLine": 306, "toLine": 306, "text": "轮换后连庄数重置为 1", "mandatory": true },
  { "ruleId": "R09-019", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.3 定庄", "fromLine": 307, "toLine": 307, "text": "一炮多响不启用，不参与换庄判定", "mandatory": true },
  { "ruleId": "R09-020", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.4 掷骰、洗牌、做牌", "fromLine": 310, "toLine": 310, "text": "掷骰得到骰子点数，决定开牌位置和翻财神取值", "mandatory": true },
  { "ruleId": "R09-021", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.4 掷骰、洗牌、做牌", "fromLine": 311, "toLine": 311, "text": "好友房发牌前检测各座位待生效洗牌道具；存在触发座位→广播并停留 5 秒，不真正重排牌墙", "mandatory": true },
  { "ruleId": "R09-022", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.4 掷骰、洗牌、做牌", "fromLine": 312, "toLine": 312, "text": "做牌开启时，定财神前进入指定牌阶段，记录各座位指定手牌与指定摸牌", "mandatory": true },
  { "ruleId": "R09-023", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.4 掷骰、洗牌、做牌", "fromLine": 313, "toLine": 313, "text": "发牌阶段按指定牌取牌；不足标准起手牌数时从牌墙补齐其余手牌", "mandatory": true },
  { "ruleId": "R09-024", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.4 掷骰、洗牌、做牌", "fromLine": 314, "toLine": 314, "text": "好友房做牌模式：掷骰后、定财神前记录指定牌；定财神后发牌时落地", "mandatory": true },
  { "ruleId": "R09-025", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.4 掷骰、洗牌、做牌", "fromLine": 315, "toLine": 315, "text": "指定牌操作入口与客户端展示【待核实】", "mandatory": true },
  { "ruleId": "R09-026", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 318, "toLine": 318, "text": "记录本局财神状态并清空历史", "mandatory": true },
  { "ruleId": "R09-027", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 319, "toLine": 319, "text": "白板财神：实际财神 = 白板，无替代牌，无翻出牌", "mandatory": true },
  { "ruleId": "R09-028", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 321, "toLine": 321, "text": "翻财神：取本局骰子点数和 S", "mandatory": true },
  { "ruleId": "R09-029", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 322, "toLine": 322, "text": "若牌墙数 = 0、S = 0 或 S > 牌墙数 → 本局不翻，实际财神回退为白板", "mandatory": true },
  { "ruleId": "R09-030", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 323, "toLine": 323, "text": "否则从牌墙尾部倒数第 S 张翻出", "mandatory": true },
  { "ruleId": "R09-031", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 324, "toLine": 324, "text": "翻出牌即实际财神，并从牌墙中移除该张", "mandatory": true },
  { "ruleId": "R09-032", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 325, "toLine": 325, "text": "若实际财神不是白板，则白板登记为替代牌；若翻出白板，则不登记", "mandatory": true },
  { "ruleId": "R09-033", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 326, "toLine": 326, "text": "翻出白板边界：实际财神仍为白板，不登记替代牌；翻出的白板从牌墙移除", "mandatory": true },
  { "ruleId": "R09-034", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 327, "toLine": 327, "text": "注册财神与替代牌，用于胡牌与听牌算法", "mandatory": true },
  { "ruleId": "R09-035", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 328, "toLine": 328, "text": "从吃、碰、杠候选组中剔除实际财神，保证财神不能用于吃碰杠", "mandatory": true },
  { "ruleId": "R09-036", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.5 定财神", "fromLine": 329, "toLine": 329, "text": "广播财神结果，等待客户端动画确认，超时 3 秒自动推进", "mandatory": true },
  { "ruleId": "R09-037", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 332, "toLine": 332, "text": "按骰子开牌位置发牌，每人起手牌数按玩法标准", "mandatory": true },
  { "ruleId": "R09-038", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 333, "toLine": 333, "text": "庄家摸第 14 张进入首摸等待", "mandatory": true },
  { "ruleId": "R09-039", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 335, "toLine": 335, "text": "首摸阶段闲家：13 张起手听牌检测", "mandatory": true },
  { "ruleId": "R09-040", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 336, "toLine": 336, "text": "首摸阶段庄家：14 张“打哪张 → 听什么牌”检测", "mandatory": true },
  { "ruleId": "R09-041", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 337, "toLine": 337, "text": "听牌提示按自摸番型口径计算；与最终结算金额不等同", "mandatory": true },
  { "ruleId": "R09-042", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 338, "toLine": 338, "text": "提示只下发信息，不授予“听”权限", "mandatory": true },
  { "ruleId": "R09-043", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 339, "toLine": 339, "text": "客户端具体展示形式【待核实】", "mandatory": true },
  { "ruleId": "R09-044", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 340, "toLine": 340, "text": "对局中有出牌权时也计算并下发“打哪张 → 听什么牌”", "mandatory": true },
  { "ruleId": "R09-045", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 340, "toLine": 340, "text": "手牌至少两张实际财神、打出一张后仍敲响时，补充“打财神 → 听任意牌”提示", "mandatory": true },
  { "ruleId": "R09-046", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.6 发牌、首摸与听牌提示", "fromLine": 340, "toLine": 340, "text": "有财必拷响开启且仅一张实际财神时，可补充打掉财神后的普通听牌提示，并排除再次摸到财神的进张", "mandatory": true },
  { "ruleId": "R09-047", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-01", "fromLine": 346, "toLine": 346, "text": "开局清理：进入开局，清局级状态、重置配置/上下文，进入本局", "mandatory": true },
  { "ruleId": "R09-048", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-02", "fromLine": 347, "toLine": 347, "text": "加倍初始化：金币场定庄前清空全桌加倍选择，等待选择", "mandatory": true },
  { "ruleId": "R09-049", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-03", "fromLine": 348, "toLine": 348, "text": "加倍上报：玩家提交时校验座位/重复，记录加倍或不加倍，广播全量", "mandatory": true },
  { "ruleId": "R09-050", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-04", "fromLine": 349, "toLine": 349, "text": "加倍超时/离线：倒计时结束，超时按不加倍；离线等超时，不阻塞", "mandatory": true },
  { "ruleId": "R09-051", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-05", "fromLine": 350, "toLine": 350, "text": "加倍完成：全员已选，广播结束，停 1 秒后进入定庄", "mandatory": true },
  { "ruleId": "R09-052", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-06", "fromLine": 351, "toLine": 351, "text": "首局定庄：第 1 局随机或房主；设首庄/连庄/牢庄，庄家确定", "mandatory": true },
  { "ruleId": "R09-053", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-07", "fromLine": 352, "toLine": 352, "text": "流局换庄：非首局流局，连庄开→不变；关→下一位，连庄数更新", "mandatory": true },
  { "ruleId": "R09-054", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-08", "fromLine": 353, "toLine": 353, "text": "胡牌换庄：非首局胡牌，赢家坐庄或逆时针轮换，庄家确定", "mandatory": true },
  { "ruleId": "R09-055", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-09", "fromLine": 354, "toLine": 354, "text": "掷骰：定庄后随机骰子，决定开牌位与翻财神", "mandatory": true },
  { "ruleId": "R09-056", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-10", "fromLine": 355, "toLine": 355, "text": "洗牌：好友房发牌前检测洗牌道具，广播并停留 5 秒，不重排牌墙", "mandatory": true },
  { "ruleId": "R09-057", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-11", "fromLine": 356, "toLine": 356, "text": "做牌记录：做牌开启，定财神前记录指定手牌/指定摸牌，指定牌入缓存", "mandatory": true },
  { "ruleId": "R09-058", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-12", "fromLine": 357, "toLine": 357, "text": "做牌发牌：发牌阶段按指定牌取牌，不足补齐，手牌定型", "mandatory": true },
  { "ruleId": "R09-059", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-13", "fromLine": 358, "toLine": 358, "text": "定财神-白板：白板财神，财神=白板，无替代牌，广播财神", "mandatory": true },
  { "ruleId": "R09-060", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-14", "fromLine": 359, "toLine": 359, "text": "定财神-翻牌：翻财神，按点数和从墙尾翻一张并移除，记录财神/翻出牌", "mandatory": true },
  { "ruleId": "R09-061", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-15", "fromLine": 360, "toLine": 360, "text": "翻出白板：翻出牌=白板，财神仍为白板，不登记替代牌，翻出白板移除", "mandatory": true },
  { "ruleId": "R09-062", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-16", "fromLine": 361, "toLine": 361, "text": "财神注册/广播：财神确定后注册财神与替代牌，广播并等 3 秒，进入发牌", "mandatory": true },
  { "ruleId": "R09-063", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-17", "fromLine": 362, "toLine": 362, "text": "发牌：定财神后按开牌位发牌，各家起手牌", "mandatory": true },
  { "ruleId": "R09-064", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-18", "fromLine": 363, "toLine": 363, "text": "庄家首摸：发牌后庄家摸第 14 张，进入首摸等待", "mandatory": true },
  { "ruleId": "R09-065", "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md", "section": "5.7 OPEN-19", "fromLine": 364, "toLine": 364, "text": "听牌提示：首摸算闲家 13 张、庄家 14 张；对局中计算打牌后听牌提示，含符合条件的打财神提示，只提示不授报听", "mandatory": true }
]
