  },
  {
    "ruleId": "R16-009",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "12.1 其他消息的客户端展示需求",
    "fromLine": 1135,
    "toLine": 1135,
    "text": "重连：恢复当前阶段界面；手牌可见性按明牌规则。",
    "mandatory": true
  },
  {
    "ruleId": "R16-010",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "12.1 展示原则",
    "fromLine": 1138,
    "toLine": 1138,
    "text": "服务端提供数据，客户端展示形式按产品/UI 确认。",
    "mandatory": true
  },
  {
    "ruleId": "R16-011",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "12.1 展示原则",
    "fromLine": 1139,
    "toLine": 1139,
    "text": "结算以最终得分为准，额外分明细不得重复计分。",
    "mandatory": true
  },
  {
    "ruleId": "R16-012",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "12.1 展示原则",
    "fromLine": 1140,
    "toLine": 1140,
    "text": "规则提示受简洁模式影响；动效类展示待客户端核实。",
    "mandatory": true
  },
  {
    "ruleId": "R16-013",
    "file": ".claude/skills/game-prd-check/references/rules/杭州麻将产品需求文档PRD.md",
    "section": "12.1 展示原则",
    "fromLine": 1141,
    "toLine": 1141,
    "text": "重连时仅展示自己的手牌；明牌开启时才展示其他玩家手牌。",
    "mandatory": true
  }
