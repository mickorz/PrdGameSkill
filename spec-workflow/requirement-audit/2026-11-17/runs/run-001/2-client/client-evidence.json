   "atomId": "AT-ST-C01-001",
   "verdict": "partial",
   "clientLogic": "GameConfigCmd 收到对局配置后写入 GameData；GameData 以简单模式开关 simple_mode 判定是否为简洁模式，用于抑制规则类提示、三摊落地动画与摸财神动效。",
   "uiInteraction": "对局内按简洁模式档位减少规则提示与部分动效；未找到创房面板的“模式”单选组（正常/简洁）与默认选中正常。",
   "messages": [
    "MsgGameConfig"
   ],
   "notes": "本次可读客户端源码为局内模块，未包含好友房创房面板，因此“模式”单选组、默认“正常”无从查证；仅能确认客户端在对局内消费简洁模式开关，属间接证据。",
   "directConflict": false,
   "conflictEvidenceIds": [],
   "observedBehavior": {
    "trigger": "好友房对局开始",
    "condition": "房间参数为简洁模式",
    "action": "对局按简洁模式抑制规则类提示与部分动画",
    "result": "玩家在对局中看到更少的提示和动效"
   },
   "evidenceIds": [
    "CLE-AT-ST-C01-001-02"
   ]
  },
